#!/usr/bin/env bash
# Документация по БД -> _out/doc/db-doc.html: структура - из миграций Liquibase модуля zhsr-database,
# описания - doc/db-doc/db-desc.yaml.
# Утилита внешняя: каталог в DOC_DB, по умолчанию ../../doc-db от корня проекта.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TOOL="${DOC_DB:-$ROOT/../../doc-db}"

# аргументы - в gen-html (например, --lang en, --strict); язык не указан - русские подписи
case " $* " in *" --lang "*|*" --lang="*|*" -en "*|*" -ru "*) ;; *) set -- -ru "$@" ;; esac
cd "$ROOT"

"$TOOL/import-struct" --liquibase zhsr-database/src/main/resources/db/changelog/db.changelog-master.xml \
    -o doc/db-doc/db-struct.yaml
"$TOOL/gen-html" "$@" --doc doc/db-doc -o _out/doc/db-doc.html
