# Параметры zhsr на сервере. setup.sh создаёт из него .env и подставляет случайные пароли вместо CHANGE_ME.

# Имя tenant: часть идентификатора БД
TENANT_NAME=demo

# БД приложения - в контейнере zhsr-db
DB_HOST=zhsr-db
DB_PORT=5432
DB_NAME=zhsr
DB_USER=zhsr
DB_PASSWORD=CHANGE_ME
DB_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}
# суперпользователь PostgreSQL: под ним ./app-reset пересоздаёт БД
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=CHANGE_ME

# Хранилище файлов - в контейнере zhsr-s3
S3_ENDPOINT=http://zhsr-s3:9000
S3_ACCESS_KEY=zhsr
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=zhsr
