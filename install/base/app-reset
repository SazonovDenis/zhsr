#!/bin/sh
set -e

# Пересоздать данные с нуля: хранилище файлов и БД, затем запустить приложение. Данные - db-data рядом: их копирует
# ./remote-reset с машины разработчика.
#   ./app-reset              - с данными db-data/default
#   ./app-reset --<каталог>  - ещё и с данными db-data/<каталог> и его фото
# Все данные на сервере пропадают.

cd "$(dirname "$0")"

[ -f .env ] || { echo "Нет .env - сначала setup.sh" >&2; exit 1; }

# каталоги данных проверяются до остановки приложения и очистки хранилища
for dir in --default "$@"; do
  case $dir in
    --?*) ;;
    *) echo "неизвестный параметр: $dir" >&2; exit 1 ;;
  esac
  [ -d "db-data/${dir#--}" ] || { echo "нет каталога данных db-data/${dir#--}: его копирует remote-reset" >&2; exit 1; }
done

echo '--- остановка сервера и nginx'
docker compose stop zhsr-nginx zhsr-app

echo '--- хранилище файлов: удаление и пустое'
docker compose rm -sf zhsr-s3
docker volume rm -f zhsr_s3_data > /dev/null
docker compose up -d zhsr-db zhsr-s3

echo '--- БД: пересоздание с данными'
docker compose pull zhsr-database
docker compose run --rm -v "$PWD/db-data:/app/db-data:ro" zhsr-database reset "$@"

./app-start
