#!/bin/sh
set -e

# Образы zhsr из build/ (сначала ./build-app) - под архитектуру этой машины, для проверки локально. Ключи - как у
# ./build-app-docker-push (install/images.sh); без ключей - все образы.

# все пути - от корня проекта
cd "$(dirname "$0")/.."
. install/images.sh

for key in $KEYS; do
    image=$(image_of "$key")
    echo "=== $image"
    install/docker-images/prepare-context "$image"
    dir="install/docker-images/$image"
    docker build -t "sazonovden/$image:latest" "$dir"
    rm -rf "$dir/tmp"
done
