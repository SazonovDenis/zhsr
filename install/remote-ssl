#!/bin/sh
set -e

# Сертификат Let's Encrypt на сервере вместо самоподписанного и его автопродление, с машины разработчика.
#   ./remote-ssl <домен> <почта>
# Домен уже должен указывать на IP сервера, порт 80 - открыт.

# все пути - от корня проекта
cd "$(dirname "$0")/.."

if [ $# -lt 2 ]; then
    echo "Использование: $0 <домен> <почта>" >&2
    exit 1
fi

. install/remote.sh

sync_base
$SSH "cd '$DEPLOY_DIR' && ./ssl-letsencrypt '$1' '$2'"
