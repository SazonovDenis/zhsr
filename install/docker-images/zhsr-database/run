#!/bin/bash
# Команды образа zhsr-database. Параметры - /app/.env (смонтирован).
#   migrate         - миграции структуры БД (по умолчанию: при каждом запуске приложения)
#   reset [--<каталог>]  - создать бакет S3_BUCKET и пересоздать БД с данными db-data/default и db-data/<каталог>
#                     (prepare/db-reset); фото db-data/<каталог>/img -> <каталог>/img/ в хранилище.
#                     Каталог данных /app/db-data подключает app-reset
set -euo pipefail
cd /app

case "${1:-migrate}" in
  migrate)
    exec $DB_MIGRATE
    ;;
  reset)
    shift
    set -a; . ./.env; set +a
    # адрес хранилища для mc: http://ключ:секрет@хост:порт
    export MC_HOST_zhsr="${S3_ENDPOINT/:\/\//://$S3_ACCESS_KEY:$S3_SECRET_KEY@}"
    mc mb --ignore-existing "zhsr/$S3_BUCKET"
    prepare/db-reset "$@"
    for a in --default "$@"; do
      img=${a#--}/img
      compgen -G "db-data/$img/*.jpg" > /dev/null || continue
      mc cp --quiet "db-data/$img/"*.jpg "zhsr/$S3_BUCKET/$img/" > /dev/null
      echo "--- фото в хранилище: $img, файлов $(compgen -G "db-data/$img/*.jpg" | wc -l)"
    done
    ;;
  *)
    echo "неизвестная команда: $1 (migrate | reset [--<каталог>])" >&2
    exit 1
    ;;
esac
