        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <!-- Данные справочников из doc/dict/<таблица>.tsv (копируются в db/dict при сборке).
         Изменили tsv - changeSet выполнится заново: строки обновятся по id, новые добавятся; description не загружается. -->

    <changeSet id="01-nsi-data-route_type" author="zhsr" runOnChange="true">
        <loadUpdateData tableName="route_type" primaryKey="id" file="db/dict/route_type.tsv" separator="\t" encoding="UTF-8">
            <column header="id" name="id" type="NUMERIC"/>
            <column header="text" name="text" type="STRING"/>
            <column header="code" name="code" type="STRING"/>
            <column header="description" type="skip"/>
        </loadUpdateData>
    </changeSet>

