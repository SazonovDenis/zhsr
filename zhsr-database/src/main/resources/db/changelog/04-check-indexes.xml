    <!-- пункт в описи - один раз -->
    <changeSet id="04-check-indexes-uq_equip_list_value_equip_list_equip_list_template_item" author="zhsr">
        <addUniqueConstraint tableName="equip_list_value" columnNames="equip_list, equip_list_template_item" constraintName="uq_equip_list_value_equip_list_equip_list_template_item"/>
    </changeSet>
    <changeSet id="04-check-indexes-ck_equip_list_value_quantity" author="zhsr">
        <sql>alter table equip_list_value add constraint ck_equip_list_value_quantity check (quantity_actual &gt;= 0 and (quantity_required is null or quantity_required &gt;= 0))</sql>
    </changeSet>

</databaseChangeLog>
