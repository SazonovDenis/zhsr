<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <!-- Заявки на ремонт: заявка, фото, журнал статусов, движение по исполнителям, примечания -->

    <!-- заявка на ремонт вагона; created_by_usr - автор, created_dt - время создания заявки пользователем;
         received_dt - время поступления заявки на сервер: заявка, поданная без связи, поступает позже создания;
         number - код компании, год (две цифры), порядковый номер в году -->
    <changeSet id="03-repair-tables-repair_request" author="zhsr">
        <createTable tableName="repair_request">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="number" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="wagon" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="trip" type="bigint"/>
            <column name="created_by_usr" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="created_dt" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="received_dt" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="fault_type" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="severity_type" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
        </createTable>
    </changeSet>

    <!-- фото к заявке; файл в хранилище файлов (S3), storage_key - ключ файла в бакете -->
    <changeSet id="03-repair-tables-repair_request_photo" author="zhsr">
        <createTable tableName="repair_request_photo">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="repair_request" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="storage_key" type="varchar(200)">
                <constraints nullable="false"/>
            </column>
            <column name="size_bytes" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="created_by_usr" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="created_dt" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="received_dt" type="timestamptz">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- журнал статусов заявки: запись действует с dbeg по dend (не включая); dend пуст - текущая запись;
         первая запись вносится при подаче заявки;
         created_by_usr - кто внёс запись: подал заявку или сменил статус; пусто - Система -->
    <changeSet id="03-repair-tables-repair_request_status" author="zhsr">
        <createTable tableName="repair_request_status">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="repair_request" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="dbeg" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="dend" type="timestamptz"/>
            <column name="request_status_type" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="created_by_usr" type="bigint"/>
        </createTable>
    </changeSet>

    <!-- журнал движения заявки по исполнителям: запись действует с dbeg по dend (не включая); dend пуст - текущая запись;
         записей нет, пока исполнителя не назначали;
         created_by_usr - кто внёс запись: назначил или снял исполнителя; пусто - Система;
         executor_usr пуст, если исполнитель снят -->
    <changeSet id="03-repair-tables-repair_request_executor" author="zhsr">
        <createTable tableName="repair_request_executor">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="repair_request" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="dbeg" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="dend" type="timestamptz"/>
            <column name="executor_usr" type="bigint"/>
            <column name="created_by_usr" type="bigint"/>
        </createTable>
    </changeSet>

    <!-- кэш текущего состояния заявки для быстрого доступа; поля вычисляемые - копия текущих записей
         repair_request_status и repair_request_executor, обновляется в той же транзакции, что и журналы;
         кроме service: служба-исполнитель определяется типом неисправности и запоминается при подаче заявки;
         dbeg_status - dbeg текущей записи repair_request_status; dbeg_executor - dbeg текущей записи repair_request_executor;
         dbeg_executor и executor_usr пусты, пока исполнителя не назначали; executor_usr пуст, если исполнитель снят -->
    <changeSet id="03-repair-tables-repair_request_info" author="zhsr">
        <createTable tableName="repair_request_info">
            <column name="repair_request" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="dbeg_status" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="request_status_type" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="service" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="dbeg_executor" type="timestamptz"/>
            <column name="executor_usr" type="bigint"/>
        </createTable>
    </changeSet>

    <!-- квитанции об отправках с телефона: защита от повторной отправки, отправка принимается один раз; одна запись -
         одна отправка вместе с её фото; основные таблицы об отложенной отправке не знают; это не журнал изменений;
         client_guid - guid отправки, присвоен телефоном;
         repair_request - созданная заявка: только у отправки новой заявки, заполняется той же транзакцией; по нему при
         повторе телефон узнаёт id заявки, без него нельзя отправить её фото и примечания;
         received_dt - время поступления отправки: только чтобы удалять старые квитанции -->
    <changeSet id="03-repair-tables-offline_receipt" author="zhsr">
        <createTable tableName="offline_receipt">
            <column name="client_guid" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="repair_request" type="bigint"/>
            <column name="received_dt" type="timestamptz">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- примечание к заявке; created_by_usr - автор; created_dt - когда пользователь написал примечание;
         received_dt - время поступления на сервер: написанное без связи поступает позже -->
    <changeSet id="03-repair-tables-repair_request_note" author="zhsr">
        <createTable tableName="repair_request_note">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="repair_request" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="created_dt" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="received_dt" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="created_by_usr" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="note" type="text">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
