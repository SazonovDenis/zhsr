<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <!-- Заявки на ремонт: заявка, фото, движение по исполнителям, пояснения -->

    <!-- заявка на ремонт вагона; usr - автор, created_dt - время подачи -->
    <changeSet id="03-repair-tables-repair_request" author="zhsr">
        <createTable tableName="repair_request">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="number" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="wagon" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="trip" type="bigint"/>
            <column name="trip_phase_type" type="bigint"/>
            <column name="service_type" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="usr" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="created_dt" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="fault_type" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="severity_type" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
        </createTable>
    </changeSet>

    <!-- фото к заявке; файл в хранилище, здесь ссылка -->
    <changeSet id="03-repair-tables-repair_request_photo" author="zhsr">
        <createTable tableName="repair_request_photo">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="repair_request" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="storage_key" type="varchar(200)">
                <constraints nullable="false"/>
            </column>
            <column name="size_bytes" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="usr" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="created_dt" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- журнал движения заявки по исполнителям: запись действует с dbeg по dend (не включая); dend пуст - текущая запись -->
    <changeSet id="03-repair-tables-repair_request_executor" author="zhsr">
        <createTable tableName="repair_request_executor">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="repair_request" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="dbeg" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="dend" type="timestamp"/>
            <column name="executor_usr" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="assigner_usr" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="request_status" type="bigint">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- кэш текущего состояния заявки для быстрого доступа; поля вычисляемые - копия текущей записи
         repair_request_executor, обновляется в той же транзакции, что и журнал;
         dbeg, executor_usr, assigner_usr пусты, пока у заявки нет исполнителя (статус NEW) -->
    <changeSet id="03-repair-tables-repair_request_info" author="zhsr">
        <createTable tableName="repair_request_info">
            <column name="repair_request" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="dbeg" type="timestamp"/>
            <column name="executor_usr" type="bigint"/>
            <column name="assigner_usr" type="bigint"/>
            <column name="request_status" type="bigint">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- пояснение к заявке; usr - автор -->
    <changeSet id="03-repair-tables-repair_request_note" author="zhsr">
        <createTable tableName="repair_request_note">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="repair_request" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="created_dt" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="usr" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="note" type="text">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
