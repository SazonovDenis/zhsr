<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <!-- НСИ: станции, депо, вагоны, маршруты -->

    <changeSet id="01-nsi-tables-station" author="zhsr">
        <createTable tableName="station">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="01-nsi-tables-depot" author="zhsr">
        <createTable tableName="depot">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="station" type="bigint"/>
        </createTable>
    </changeSet>

    <!-- Тип вагона: купейный, плацкартный и т. п. -->
    <changeSet id="01-nsi-tables-wagon_type" author="zhsr">
        <createTable tableName="wagon_type">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="varchar(1000)"/>
        </createTable>
    </changeSet>

    <!-- Модель вагона: Тулпар-Тальго, Stadler и т. п. -->
    <changeSet id="01-nsi-tables-wagon_model" author="zhsr">
        <createTable tableName="wagon_model">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="varchar(1000)"/>
        </createTable>
    </changeSet>

    <!-- wagon_status - код из справочника doc/dict -->
    <changeSet id="01-nsi-tables-wagon" author="zhsr">
        <createTable tableName="wagon">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="number" type="varchar(8)">
                <constraints nullable="false"/>
            </column>
            <column name="wagon_type" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="wagon_model" type="bigint"/>
            <column name="build_year" type="integer"/>
            <column name="depot" type="bigint"/>
            <column name="wagon_status" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="data" type="jsonb"/>
        </createTable>
    </changeSet>

    <changeSet id="01-nsi-tables-route" author="zhsr">
        <createTable tableName="route">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="train_number" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="duration" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="conductor_hours" type="integer"/>
            <column name="lnp_hours" type="integer"/>
            <column name="pem_hours" type="integer"/>
            <column name="active" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="01-nsi-tables-route_stop" author="zhsr">
        <createTable tableName="route_stop">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="route" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="seq" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="station" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="km" type="integer">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
