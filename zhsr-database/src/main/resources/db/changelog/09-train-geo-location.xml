<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <!-- положение поезда на местности по времени, очищенные данные: по нему строится ход рейса на карте; у поезда вне
         рейса новых строк нет; x - долгота, y - широта (WGS 84); dt - момент, в который вычислено положение -->
    <changeSet id="09-train-geo-location-train_geo_location" author="zhsr">
        <createTable tableName="train_geo_location">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="train" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="dt" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="x" type="numeric(9,6)">
                <constraints nullable="false"/>
            </column>
            <column name="y" type="numeric(9,6)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="09-train-geo-location-fk_train_geo_location_train" author="zhsr">
        <addForeignKeyConstraint baseTableName="train_geo_location" baseColumnNames="train"
                                 constraintName="fk_train_geo_location_train"
                                 referencedTableName="train" referencedColumnNames="id"/>
    </changeSet>

    <!-- ход поезда за время рейса; не уникальный - по той же причине, что у wagon_geo_location -->
    <changeSet id="09-train-geo-location-ix_train_geo_location_train_dt" author="zhsr">
        <createIndex tableName="train_geo_location" indexName="ix_train_geo_location_train_dt">
            <column name="train"/>
            <column name="dt"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
