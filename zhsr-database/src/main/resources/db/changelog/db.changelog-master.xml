<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <!--
        <группа>-tables.xml    - таблицы, типы колонок, NOT NULL
        <группа>-indexes.xml   - внешние ключи, уникальные ограничения, индексы
        <группа>-data.xml      - данные справочников

        Внешние ключи накладываются после того, как созданы все таблицы.

        Имена ограничений и индексов: <префикс>_<таблица>_<поля>, префиксы pk, fk, uq, ck, ex, ix, ux.
        PostgreSQL обрезает имена длиннее 63 символов. Поля пишутся всегда полностью; если имя не помещается,
        имя таблицы заменяется аббревиатурой из списка ниже - одной и той же во всех таких именах:
            (пока нет)

        repair-act.xml (repair_act, repair_close_act) в общую миграцию не входит.
    -->

    <include file="db/changelog/01-nsi-tables.xml"/>

    <include file="db/changelog/01-nsi-indexes.xml"/>

    <include file="db/changelog/01-nsi-data.xml"/>

    <include file="db/changelog/02-location-tables.xml"/>

    <include file="db/changelog/02-location-indexes.xml"/>

    <include file="db/changelog/03-repair-tables.xml"/>

    <include file="db/changelog/03-repair-indexes.xml"/>

</databaseChangeLog>
