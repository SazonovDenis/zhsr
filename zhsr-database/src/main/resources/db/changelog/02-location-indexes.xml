    </changeSet>

    <changeSet id="02-location-indexes-uq_transfer_act_wagon_wagon_location" author="zhsr">
        <addUniqueConstraint tableName="transfer_act_wagon" columnNames="wagon_location" constraintName="uq_transfer_act_wagon_wagon_location"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_transfer_act_wagon_wagon_responsible" author="zhsr">
        <addForeignKeyConstraint baseTableName="transfer_act_wagon" baseColumnNames="wagon_responsible" constraintName="fk_transfer_act_wagon_wagon_responsible"
                                 referencedTableName="wagon_responsible" referencedColumnNames="id" onDelete="SET NULL"/>
    </changeSet>

    <changeSet id="02-location-indexes-uq_transfer_act_wagon_wagon_responsible" author="zhsr">
        <addUniqueConstraint tableName="transfer_act_wagon" columnNames="wagon_responsible" constraintName="uq_transfer_act_wagon_wagon_responsible"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_transfer_act_wagon_closed_wagon_responsible" author="zhsr">
        <addForeignKeyConstraint baseTableName="transfer_act_wagon" baseColumnNames="closed_wagon_responsible" constraintName="fk_transfer_act_wagon_closed_wagon_responsible"
                                 referencedTableName="wagon_responsible" referencedColumnNames="id" onDelete="SET NULL"/>
    </changeSet>

    <!-- usr_geo_location -->

    <changeSet id="02-location-indexes-fk_usr_geo_location_usr" author="zhsr">
        <addForeignKeyConstraint baseTableName="usr_geo_location" baseColumnNames="usr" constraintName="fk_usr_geo_location_usr"
                                 referencedTableName="usr" referencedColumnNames="id"/>
