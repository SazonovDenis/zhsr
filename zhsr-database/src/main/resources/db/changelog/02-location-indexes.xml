        <addForeignKeyConstraint baseTableName="transfer_act" baseColumnNames="yard" constraintName="fk_transfer_act_yard"
                                 referencedTableName="yard" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_transfer_act_work_type" author="zhsr">
        <addForeignKeyConstraint baseTableName="transfer_act" baseColumnNames="work_type" constraintName="fk_transfer_act_work_type"
                                 referencedTableName="work_type" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_transfer_act_act_status_type" author="zhsr">
        <addForeignKeyConstraint baseTableName="transfer_act" baseColumnNames="act_status_type" constraintName="fk_transfer_act_act_status_type"
                                 referencedTableName="act_status_type" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_transfer_act_transferred_by_usr" author="zhsr">
        <addForeignKeyConstraint baseTableName="transfer_act" baseColumnNames="transferred_by_usr" constraintName="fk_transfer_act_transferred_by_usr"
                                 referencedTableName="usr" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_transfer_act_received_by_usr" author="zhsr">
        <addForeignKeyConstraint baseTableName="transfer_act" baseColumnNames="received_by_usr" constraintName="fk_transfer_act_received_by_usr"
                                 referencedTableName="usr" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_transfer_act_act_cancellation" author="zhsr">
        <addForeignKeyConstraint baseTableName="transfer_act" baseColumnNames="act_cancellation" constraintName="fk_transfer_act_act_cancellation"
                                 referencedTableName="act_cancellation" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-uq_transfer_act_act_cancellation" author="zhsr">
        <addUniqueConstraint tableName="transfer_act" columnNames="act_cancellation" constraintName="uq_transfer_act_act_cancellation"/>
    </changeSet>

    <!-- акт - в депо или в парк отстоя -->
    <changeSet id="02-location-indexes-ck_transfer_act_place" author="zhsr">
        <sql>alter table transfer_act add constraint ck_transfer_act_place check (num_nonnulls(depot, yard) = 1)</sql>
    </changeSet>

    <!-- приём или отказ: пуст у ожидающего приёма, заполнен у проведённого и отказа, у отменённого - как был до отмены;
         id из act_status_type.tsv: 1 - ожидает приёма, 2 - проведён, 3 - отказ, 4 - отменён -->
    <changeSet id="02-location-indexes-ck_transfer_act_received" author="zhsr">
        <sql>alter table transfer_act add constraint ck_transfer_act_received check ((act_status_type = 1 and num_nonnulls(received_by_usr, received_dt) = 0) or (act_status_type in (2, 3) and num_nulls(received_by_usr, received_dt) = 0) or (act_status_type = 4 and num_nulls(received_by_usr, received_dt) in (0, 2)))</sql>
    </changeSet>

    <!-- причина отказа - у отказа и, если отказ был до отмены, у отменённого -->
    <changeSet id="02-location-indexes-ck_transfer_act_reject" author="zhsr">
        <sql>alter table transfer_act add constraint ck_transfer_act_reject check ((act_status_type = 3 and reject_reason is not null) or (act_status_type in (1, 2) and reject_reason is null) or (act_status_type = 4 and (reject_reason is null or received_dt is not null)))</sql>
    </changeSet>

    <!-- статус "отменён" - только со ссылкой на акт отмены -->
    <changeSet id="02-location-indexes-ck_transfer_act_cancelled" author="zhsr">
        <sql>alter table transfer_act add constraint ck_transfer_act_cancelled check ((act_status_type = 4) = (act_cancellation is not null))</sql>
    </changeSet>

    <!-- акты, которые ждут приёма -->
    <changeSet id="02-location-indexes-ix_transfer_act_pending" author="zhsr">
        <sql>create index ix_transfer_act_pending on transfer_act (act_status_type) where act_status_type = 1</sql>
    </changeSet>

    <changeSet id="02-location-indexes-uq_transfer_act_wagon_transfer_act_wagon" author="zhsr">
        <addUniqueConstraint tableName="transfer_act_wagon" columnNames="transfer_act, wagon" constraintName="uq_transfer_act_wagon_transfer_act_wagon"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_transfer_act_wagon_transfer_act" author="zhsr">
        <addForeignKeyConstraint baseTableName="transfer_act_wagon" baseColumnNames="transfer_act" constraintName="fk_transfer_act_wagon_transfer_act"
                                 referencedTableName="transfer_act" referencedColumnNames="id" onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_transfer_act_wagon_wagon" author="zhsr">
        <addForeignKeyConstraint baseTableName="transfer_act_wagon" baseColumnNames="wagon" constraintName="fk_transfer_act_wagon_wagon"
                                 referencedTableName="wagon" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-ix_transfer_act_wagon_wagon" author="zhsr">
        <createIndex tableName="transfer_act_wagon" indexName="ix_transfer_act_wagon_wagon">
            <column name="wagon"/>
        </createIndex>
    </changeSet>

    <changeSet id="02-location-indexes-fk_transfer_act_wagon_wagon_location" author="zhsr">
        <addForeignKeyConstraint baseTableName="transfer_act_wagon" baseColumnNames="wagon_location" constraintName="fk_transfer_act_wagon_wagon_location"
                                 referencedTableName="wagon_location" referencedColumnNames="id" onDelete="SET NULL"/>
    </changeSet>

    <changeSet id="02-location-indexes-uq_transfer_act_wagon_wagon_location" author="zhsr">
        <addUniqueConstraint tableName="transfer_act_wagon" columnNames="wagon_location" constraintName="uq_transfer_act_wagon_wagon_location"/>
    </changeSet>

    <!-- coupling_act: акт проведён или отменён; id из act_status_type.tsv: 2 - проведён, 4 - отменён -->
    <changeSet id="02-location-indexes-ck_coupling_act_act_status_type" author="zhsr">
        <sql>alter table coupling_act add constraint ck_coupling_act_act_status_type check (act_status_type in (2, 4))</sql>
    </changeSet>

    <!-- статус "отменён" - только со ссылкой на акт отмены -->
    <changeSet id="02-location-indexes-ck_coupling_act_cancelled" author="zhsr">
        <sql>alter table coupling_act add constraint ck_coupling_act_cancelled check ((act_status_type = 4) = (act_cancellation is not null))</sql>
    </changeSet>

</databaseChangeLog>
