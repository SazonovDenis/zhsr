        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <!-- Расположение вагонов: уникальность, внешние ключи, проверки, индексы.
         Ссылка называется как таблица, на которую ссылается; ссылка с ролью - роль и имя таблицы в конце: created_by_usr -->

    <!-- wagon_location -->

    <changeSet id="02-location-indexes-fk_wagon_location_wagon" author="zhsr">
        <addForeignKeyConstraint baseTableName="wagon_location" baseColumnNames="wagon" constraintName="fk_wagon_location_wagon"
                                 referencedTableName="wagon" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-ck_wagon_location_period" author="zhsr">
        <sql>alter table wagon_location add constraint ck_wagon_location_period check (dend is null or dend &gt; dbeg)</sql>
    </changeSet>

    <!-- у вагона одна текущая запись -->
    <changeSet id="02-location-indexes-ux_wagon_location_current" author="zhsr">
        <sql>create unique index ux_wagon_location_current on wagon_location (wagon) where dend is null</sql>
    </changeSet>

    <!-- периоды вагона не пересекаются -->
    <changeSet id="02-location-indexes-ex_wagon_location_overlap" author="zhsr">
        <sql>alter table wagon_location add constraint ex_wagon_location_overlap exclude using gist (wagon with =, tsrange(dbeg, dend) with &amp;&amp;)</sql>
    </changeSet>

    <changeSet id="02-location-indexes-fk_wagon_location_station" author="zhsr">
        <addForeignKeyConstraint baseTableName="wagon_location" baseColumnNames="station" constraintName="fk_wagon_location_station"
                                 referencedTableName="station" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_wagon_location_depot" author="zhsr">
        <addForeignKeyConstraint baseTableName="wagon_location" baseColumnNames="depot" constraintName="fk_wagon_location_depot"
                                 referencedTableName="depot" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_wagon_location_yard" author="zhsr">
        <addForeignKeyConstraint baseTableName="wagon_location" baseColumnNames="yard" constraintName="fk_wagon_location_yard"
                                 referencedTableName="yard" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_wagon_location_trip" author="zhsr">
        <addForeignKeyConstraint baseTableName="wagon_location" baseColumnNames="trip" constraintName="fk_wagon_location_trip"
                                 referencedTableName="trip" referencedColumnNames="id"/>
    </changeSet>

    <!-- у вагона ровно одно расположение -->
    <changeSet id="02-location-indexes-ck_wagon_location_one" author="zhsr">
        <sql>alter table wagon_location add constraint ck_wagon_location_one check (num_nonnulls(station, depot, yard, trip) = 1)</sql>
    </changeSet>

    <changeSet id="02-location-indexes-fk_wagon_location_location_type" author="zhsr">
        <addForeignKeyConstraint baseTableName="wagon_location" baseColumnNames="location_type" constraintName="fk_wagon_location_location_type"
                                 referencedTableName="location_type" referencedColumnNames="id"/>
    </changeSet>

    <!-- заполнена ссылка, заданная видом расположения; id из location_type.tsv: 1 - станция, 2 - депо, 3 - рейс, 4 - парк отстоя -->
    <changeSet id="02-location-indexes-ck_wagon_location_location_type" author="zhsr">
        <sql>alter table wagon_location add constraint ck_wagon_location_location_type check ((location_type = 1 and station is not null) or (location_type = 2 and depot is not null) or (location_type = 3 and trip is not null) or (location_type = 4 and yard is not null))</sql>
    </changeSet>

