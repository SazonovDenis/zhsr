                                 referencedTableName="usr" referencedColumnNames="id"/>
    </changeSet>

    <!-- отработанный план: запись плана не удаляется, удаление факта возвращает её в «ожидает» -->
    <changeSet id="02-location-indexes-fk_train_wagon_change_plan" author="zhsr">
        <addForeignKeyConstraint baseTableName="train_wagon_change" baseColumnNames="plan" constraintName="fk_train_wagon_change_plan"
                                 referencedTableName="train_wagon_change" referencedColumnNames="id"/>
    </changeSet>

    <!-- план отрабатывает один факт -->
    <changeSet id="02-location-indexes-ux_train_wagon_change_plan" author="zhsr">
        <sql>create unique index ux_train_wagon_change_plan on train_wagon_change (plan) where plan is not null</sql>
    </changeSet>

    <changeSet id="02-location-indexes-fk_train_wagon_change_wagon_location" author="zhsr">
        <addForeignKeyConstraint baseTableName="train_wagon_change" baseColumnNames="wagon_location" constraintName="fk_train_wagon_change_wagon_location"
                                 referencedTableName="wagon_location" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-uq_train_wagon_change_wagon_location" author="zhsr">
        <addUniqueConstraint tableName="train_wagon_change" columnNames="wagon_location" constraintName="uq_train_wagon_change_wagon_location"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_train_wagon_change_wagon_status" author="zhsr">
        <addForeignKeyConstraint baseTableName="train_wagon_change" baseColumnNames="wagon_status" constraintName="fk_train_wagon_change_wagon_status"
                                 referencedTableName="wagon_status" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-uq_train_wagon_change_wagon_status" author="zhsr">
        <addUniqueConstraint tableName="train_wagon_change" columnNames="wagon_status" constraintName="uq_train_wagon_change_wagon_status"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_train_wagon_change_wagon_responsible" author="zhsr">
        <addForeignKeyConstraint baseTableName="train_wagon_change" baseColumnNames="wagon_responsible" constraintName="fk_train_wagon_change_wagon_responsible"
                                 referencedTableName="wagon_responsible" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-uq_train_wagon_change_wagon_responsible" author="zhsr">
        <addUniqueConstraint tableName="train_wagon_change" columnNames="wagon_responsible" constraintName="uq_train_wagon_change_wagon_responsible"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_train_wagon_change_closed_wagon_responsible" author="zhsr">
        <addForeignKeyConstraint baseTableName="train_wagon_change" baseColumnNames="closed_wagon_responsible" constraintName="fk_train_wagon_change_closed_wagon_responsible"
                                 referencedTableName="wagon_responsible" referencedColumnNames="id"/>
    </changeSet>

    <!-- вид: 1 - прицепка, 2 - отцепка (TrainWagonChangeType); позиция - только у прицепки, с 1 -->
    <changeSet id="02-location-indexes-ck_train_wagon_change_change_type" author="zhsr">
        <sql>alter table train_wagon_change add constraint ck_train_wagon_change_change_type check (change_type in (1, 2) and (change_type = 1) = (seq is not null) and (seq is null or seq &gt; 0))</sql>
    </changeSet>

    <!-- слой: 1 - план, 2 - факт (TrainWagonKind); статус - только у плана: 1 - ожидает, 2 - отработан, 3 - отменён
         (TrainWagonPlanStatus); ссылка на план и записи журналов вагона - только у факта -->
    <changeSet id="02-location-indexes-ck_train_wagon_change_kind" author="zhsr">
        <sql>alter table train_wagon_change add constraint ck_train_wagon_change_kind check (kind in (1, 2) and (kind = 1) = (plan_status is not null) and (plan_status is null or plan_status in (1, 2, 3)) and (kind = 2 or num_nonnulls(plan, wagon_location, wagon_status, wagon_responsible, closed_wagon_responsible) = 0))</sql>
    </changeSet>

    <!-- рейс и остановка его маршрута заданы вместе -->
    <changeSet id="02-location-indexes-ck_train_wagon_change_trip" author="zhsr">
        <sql>alter table train_wagon_change add constraint ck_train_wagon_change_trip check ((trip is null) = (route_station is null))</sql>
    </changeSet>

    <!-- журнал поезда по слоям и времени: последний факт, ожидающие планы, перестроение состояния -->
    <changeSet id="02-location-indexes-ix_train_wagon_change_train" author="zhsr">
        <sql>create index ix_train_wagon_change_train on train_wagon_change (train, kind, dt)</sql>
    </changeSet>

    <!-- журнал вагона: занятость вагона, последний факт вагона -->
    <changeSet id="02-location-indexes-ix_train_wagon_change_wagon" author="zhsr">
        <sql>create index ix_train_wagon_change_wagon on train_wagon_change (wagon, kind, dt)</sql>
    </changeSet>

    <!-- прицепки и отцепки рейса -->
    <changeSet id="02-location-indexes-ix_train_wagon_change_trip" author="zhsr">
        <sql>create index ix_train_wagon_change_trip on train_wagon_change (trip) where trip is not null</sql>
    </changeSet>

    <!-- wagon_run: пробег удаляется вместе с фактом прицепки -->

    <changeSet id="02-location-indexes-fk_wagon_run_wagon" author="zhsr">
        <addForeignKeyConstraint baseTableName="wagon_run" baseColumnNames="wagon" constraintName="fk_wagon_run_wagon"
                                 referencedTableName="wagon" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_wagon_run_trip" author="zhsr">
        <addForeignKeyConstraint baseTableName="wagon_run" baseColumnNames="trip" constraintName="fk_wagon_run_trip"
                                 referencedTableName="trip" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_wagon_run_train_wagon_change" author="zhsr">
        <addForeignKeyConstraint baseTableName="wagon_run" baseColumnNames="train_wagon_change" constraintName="fk_wagon_run_train_wagon_change"
                                 referencedTableName="train_wagon_change" referencedColumnNames="id" onDelete="CASCADE"/>
    </changeSet>

    <!-- одно участие в поезде (факт прицепки) - один участок в рейсе -->
    <changeSet id="02-location-indexes-ux_wagon_run_trip_train_wagon_change" author="zhsr">
        <sql>create unique index ux_wagon_run_trip_train_wagon_change on wagon_run (trip, train_wagon_change)</sql>
    </changeSet>

    <changeSet id="02-location-indexes-ck_wagon_run_km" author="zhsr">
        <sql>alter table wagon_run add constraint ck_wagon_run_km check (km &gt;= 0)</sql>
    </changeSet>

    <changeSet id="02-location-indexes-ix_wagon_run_wagon" author="zhsr">
        <sql>create index ix_wagon_run_wagon on wagon_run (wagon)</sql>
    </changeSet>

    <!-- trip_crew: бригада удаляется вместе с рейсом -->

    <changeSet id="02-location-indexes-fk_trip_crew_trip" author="zhsr">
        <addForeignKeyConstraint baseTableName="trip_crew" baseColumnNames="trip" constraintName="fk_trip_crew_trip"
                                 referencedTableName="trip" referencedColumnNames="id" onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_trip_crew_crew_duty_type" author="zhsr">
        <addForeignKeyConstraint baseTableName="trip_crew" baseColumnNames="crew_duty_type" constraintName="fk_trip_crew_crew_duty_type"
                                 referencedTableName="crew_duty_type" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_trip_crew_usr" author="zhsr">
        <addForeignKeyConstraint baseTableName="trip_crew" baseColumnNames="usr" constraintName="fk_trip_crew_usr"
                                 referencedTableName="usr" referencedColumnNames="id"/>
    </changeSet>

    <!-- сотрудник - одна строка бригады рейса -->
    <changeSet id="02-location-indexes-uq_trip_crew_trip_usr" author="zhsr">
        <addUniqueConstraint tableName="trip_crew" columnNames="trip, usr" constraintName="uq_trip_crew_trip_usr"/>
    </changeSet>

    <!-- начальник поезда и ПЭМ - не больше одного на дежурстве в рейсе; id из crew_duty_type.tsv: 2 - начальник поезда,
         3 - ПЭМ -->
    <changeSet id="02-location-indexes-ux_trip_crew_trip_crew_duty_type" author="zhsr">
        <sql>create unique index ux_trip_crew_trip_crew_duty_type on trip_crew (trip, crew_duty_type) where crew_duty_type in (2, 3) and dend is null</sql>
    </changeSet>

    <changeSet id="02-location-indexes-ck_trip_crew_period" author="zhsr">
        <sql>alter table trip_crew add constraint ck_trip_crew_period check (dend is null or dbeg is null or dend &gt;= dbeg)</sql>
    </changeSet>

    <changeSet id="02-location-indexes-ix_trip_crew_usr" author="zhsr">
        <createIndex tableName="trip_crew" indexName="ix_trip_crew_usr">
            <column name="usr"/>
        </createIndex>
    </changeSet>

    <!-- act_cancellation -->

    <changeSet id="02-location-indexes-fk_act_cancellation_created_by_usr" author="zhsr">
        <addForeignKeyConstraint baseTableName="act_cancellation" baseColumnNames="created_by_usr" constraintName="fk_act_cancellation_created_by_usr"
                                 referencedTableName="usr" referencedColumnNames="id"/>
    </changeSet>

    <!-- transfer_act: строки удаляются вместе с актом -->

    <changeSet id="02-location-indexes-uq_transfer_act_number" author="zhsr">
        <addUniqueConstraint tableName="transfer_act" columnNames="number" constraintName="uq_transfer_act_number"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_transfer_act_from_station" author="zhsr">
        <addForeignKeyConstraint baseTableName="transfer_act" baseColumnNames="from_station" constraintName="fk_transfer_act_from_station"
                                 referencedTableName="station" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_transfer_act_from_depot" author="zhsr">
        <addForeignKeyConstraint baseTableName="transfer_act" baseColumnNames="from_depot" constraintName="fk_transfer_act_from_depot"
                                 referencedTableName="depot" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_transfer_act_from_yard" author="zhsr">
        <addForeignKeyConstraint baseTableName="transfer_act" baseColumnNames="from_yard" constraintName="fk_transfer_act_from_yard"
                                 referencedTableName="yard" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_transfer_act_to_station" author="zhsr">
        <addForeignKeyConstraint baseTableName="transfer_act" baseColumnNames="to_station" constraintName="fk_transfer_act_to_station"
                                 referencedTableName="station" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_transfer_act_to_depot" author="zhsr">
        <addForeignKeyConstraint baseTableName="transfer_act" baseColumnNames="to_depot" constraintName="fk_transfer_act_to_depot"
                                 referencedTableName="depot" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_transfer_act_to_yard" author="zhsr">
        <addForeignKeyConstraint baseTableName="transfer_act" baseColumnNames="to_yard" constraintName="fk_transfer_act_to_yard"
                                 referencedTableName="yard" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_transfer_act_work_type" author="zhsr">
        <addForeignKeyConstraint baseTableName="transfer_act" baseColumnNames="work_type" constraintName="fk_transfer_act_work_type"
                                 referencedTableName="work_type" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_transfer_act_act_status_type" author="zhsr">
        <addForeignKeyConstraint baseTableName="transfer_act" baseColumnNames="act_status_type" constraintName="fk_transfer_act_act_status_type"
                                 referencedTableName="act_status_type" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_transfer_act_transferred_by_usr" author="zhsr">
        <addForeignKeyConstraint baseTableName="transfer_act" baseColumnNames="transferred_by_usr" constraintName="fk_transfer_act_transferred_by_usr"
                                 referencedTableName="usr" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_transfer_act_received_by_usr" author="zhsr">
        <addForeignKeyConstraint baseTableName="transfer_act" baseColumnNames="received_by_usr" constraintName="fk_transfer_act_received_by_usr"
                                 referencedTableName="usr" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_transfer_act_act_cancellation" author="zhsr">
        <addForeignKeyConstraint baseTableName="transfer_act" baseColumnNames="act_cancellation" constraintName="fk_transfer_act_act_cancellation"
                                 referencedTableName="act_cancellation" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-uq_transfer_act_act_cancellation" author="zhsr">
        <addUniqueConstraint tableName="transfer_act" columnNames="act_cancellation" constraintName="uq_transfer_act_act_cancellation"/>
    </changeSet>

    <!-- откуда - ровно одно из: станция, депо, парк отстоя -->
    <changeSet id="02-location-indexes-ck_transfer_act_from" author="zhsr">
        <sql>alter table transfer_act add constraint ck_transfer_act_from check (num_nonnulls(from_station, from_depot, from_yard) = 1)</sql>
    </changeSet>

    <!-- куда - ровно одно из: станция, депо, парк отстоя -->
    <changeSet id="02-location-indexes-ck_transfer_act_to" author="zhsr">
        <sql>alter table transfer_act add constraint ck_transfer_act_to check (num_nonnulls(to_station, to_depot, to_yard) = 1)</sql>
    </changeSet>

    <!-- откуда и куда - разные расположения; со станции на станцию не передаётся; одна станция проверяется в коде -->
    <changeSet id="02-location-indexes-ck_transfer_act_places" author="zhsr">
        <sql>alter table transfer_act add constraint ck_transfer_act_places check (num_nonnulls(from_station, to_station) &lt; 2 and (from_depot = to_depot) is not true and (from_yard = to_yard) is not true)</sql>
    </changeSet>

    <!-- приём или отказ: пуст у ожидающего приёма, заполнен у проведённого и отказа, у отменённого - как был до отмены;
         id из act_status_type.tsv: 1 - ожидает приёма, 2 - проведён, 3 - отказ, 4 - отменён -->
    <changeSet id="02-location-indexes-ck_transfer_act_received" author="zhsr">
        <sql>alter table transfer_act add constraint ck_transfer_act_received check ((act_status_type = 1 and num_nonnulls(received_by_usr, received_dt) = 0) or (act_status_type in (2, 3) and num_nulls(received_by_usr, received_dt) = 0) or (act_status_type = 4 and num_nulls(received_by_usr, received_dt) in (0, 2)))</sql>
    </changeSet>

    <!-- причина отказа - у отказа и, если отказ был до отмены, у отменённого -->
    <changeSet id="02-location-indexes-ck_transfer_act_reject" author="zhsr">
        <sql>alter table transfer_act add constraint ck_transfer_act_reject check ((act_status_type = 3 and reject_reason is not null) or (act_status_type in (1, 2) and reject_reason is null) or (act_status_type = 4 and (reject_reason is null or received_dt is not null)))</sql>
    </changeSet>

    <!-- статус "отменён" - только со ссылкой на акт отмены -->
    <changeSet id="02-location-indexes-ck_transfer_act_cancelled" author="zhsr">
        <sql>alter table transfer_act add constraint ck_transfer_act_cancelled check ((act_status_type = 4) = (act_cancellation is not null))</sql>
    </changeSet>

    <!-- акты, которые ждут приёма -->
    <changeSet id="02-location-indexes-ix_transfer_act_pending" author="zhsr">
        <sql>create index ix_transfer_act_pending on transfer_act (act_status_type) where act_status_type = 1</sql>
    </changeSet>

    <changeSet id="02-location-indexes-uq_transfer_act_wagon_transfer_act_wagon" author="zhsr">
        <addUniqueConstraint tableName="transfer_act_wagon" columnNames="transfer_act, wagon" constraintName="uq_transfer_act_wagon_transfer_act_wagon"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_transfer_act_wagon_transfer_act" author="zhsr">
        <addForeignKeyConstraint baseTableName="transfer_act_wagon" baseColumnNames="transfer_act" constraintName="fk_transfer_act_wagon_transfer_act"
                                 referencedTableName="transfer_act" referencedColumnNames="id" onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_transfer_act_wagon_wagon" author="zhsr">
        <addForeignKeyConstraint baseTableName="transfer_act_wagon" baseColumnNames="wagon" constraintName="fk_transfer_act_wagon_wagon"
                                 referencedTableName="wagon" referencedColumnNames="id"/>
    </changeSet>

