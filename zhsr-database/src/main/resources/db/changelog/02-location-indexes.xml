<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <!-- Расположение вагонов: уникальность, внешние ключи, проверки, индексы.
         Ссылка называется как таблица, на которую ссылается; ссылка с ролью - роль и имя таблицы в конце: created_by_usr -->

    <!-- wagon_location -->

    <changeSet id="02-location-indexes-fk_wagon_location_wagon" author="zhsr">
        <addForeignKeyConstraint baseTableName="wagon_location" baseColumnNames="wagon" constraintName="fk_wagon_location_wagon"
                                 referencedTableName="wagon" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-ck_wagon_location_period" author="zhsr">
        <sql>alter table wagon_location add constraint ck_wagon_location_period check (dend is null or dend &gt; dbeg)</sql>
    </changeSet>

    <!-- у вагона одна текущая запись -->
    <changeSet id="02-location-indexes-ux_wagon_location_current" author="zhsr">
        <sql>create unique index ux_wagon_location_current on wagon_location (wagon) where dend is null</sql>
    </changeSet>

    <!-- периоды вагона не пересекаются -->
    <changeSet id="02-location-indexes-ex_wagon_location_overlap" author="zhsr">
        <sql>alter table wagon_location add constraint ex_wagon_location_overlap exclude using gist (wagon with =, tstzrange(dbeg, dend) with &amp;&amp;)</sql>
    </changeSet>

    <changeSet id="02-location-indexes-fk_wagon_location_station" author="zhsr">
        <addForeignKeyConstraint baseTableName="wagon_location" baseColumnNames="station" constraintName="fk_wagon_location_station"
                                 referencedTableName="station" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_wagon_location_depot" author="zhsr">
        <addForeignKeyConstraint baseTableName="wagon_location" baseColumnNames="depot" constraintName="fk_wagon_location_depot"
                                 referencedTableName="depot" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_wagon_location_yard" author="zhsr">
        <addForeignKeyConstraint baseTableName="wagon_location" baseColumnNames="yard" constraintName="fk_wagon_location_yard"
                                 referencedTableName="yard" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_wagon_location_trip" author="zhsr">
        <addForeignKeyConstraint baseTableName="wagon_location" baseColumnNames="trip" constraintName="fk_wagon_location_trip"
                                 referencedTableName="trip" referencedColumnNames="id"/>
    </changeSet>

    <!-- у вагона ровно одно расположение -->
    <changeSet id="02-location-indexes-ck_wagon_location_one" author="zhsr">
        <sql>alter table wagon_location add constraint ck_wagon_location_one check (num_nonnulls(station, depot, yard, trip) = 1)</sql>
    </changeSet>

    <changeSet id="02-location-indexes-fk_wagon_location_location_type" author="zhsr">
        <addForeignKeyConstraint baseTableName="wagon_location" baseColumnNames="location_type" constraintName="fk_wagon_location_location_type"
                                 referencedTableName="location_type" referencedColumnNames="id"/>
    </changeSet>

    <!-- заполнена ссылка, заданная видом расположения; id из location_type.tsv: 1 - станция, 2 - депо, 3 - рейс, 4 - парк отстоя -->
    <changeSet id="02-location-indexes-ck_wagon_location_location_type" author="zhsr">
        <sql>alter table wagon_location add constraint ck_wagon_location_location_type check ((location_type = 1 and station is not null) or (location_type = 2 and depot is not null) or (location_type = 3 and trip is not null) or (location_type = 4 and yard is not null))</sql>
    </changeSet>

    <!-- дислокация: текущие расположения вагонов -->
    <changeSet id="02-location-indexes-ix_wagon_location_station_current" author="zhsr">
        <sql>create index ix_wagon_location_station_current on wagon_location (station) where dend is null</sql>
    </changeSet>

    <changeSet id="02-location-indexes-ix_wagon_location_depot_current" author="zhsr">
        <sql>create index ix_wagon_location_depot_current on wagon_location (depot) where dend is null</sql>
    </changeSet>

    <changeSet id="02-location-indexes-ix_wagon_location_yard_current" author="zhsr">
        <sql>create index ix_wagon_location_yard_current on wagon_location (yard) where dend is null</sql>
    </changeSet>

    <changeSet id="02-location-indexes-ix_wagon_location_trip_current" author="zhsr">
        <sql>create index ix_wagon_location_trip_current on wagon_location (trip) where dend is null</sql>
    </changeSet>

    <!-- ссылки на справочники -->

    <changeSet id="02-location-indexes-fk_trip_trip_status_type" author="zhsr">
        <addForeignKeyConstraint baseTableName="trip" baseColumnNames="trip_status_type" constraintName="fk_trip_trip_status_type"
                                 referencedTableName="trip_status_type" referencedColumnNames="id"/>
    </changeSet>

    <!-- wagon_status -->

    <changeSet id="02-location-indexes-fk_wagon_status_wagon" author="zhsr">
        <addForeignKeyConstraint baseTableName="wagon_status" baseColumnNames="wagon" constraintName="fk_wagon_status_wagon"
                                 referencedTableName="wagon" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_wagon_status_wagon_status_type" author="zhsr">
        <addForeignKeyConstraint baseTableName="wagon_status" baseColumnNames="wagon_status_type" constraintName="fk_wagon_status_wagon_status_type"
                                 referencedTableName="wagon_status_type" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-ck_wagon_status_period" author="zhsr">
        <sql>alter table wagon_status add constraint ck_wagon_status_period check (dend is null or dend &gt; dbeg)</sql>
    </changeSet>

    <!-- у вагона одна текущая запись -->
    <changeSet id="02-location-indexes-ux_wagon_status_current" author="zhsr">
        <sql>create unique index ux_wagon_status_current on wagon_status (wagon) where dend is null</sql>
    </changeSet>

    <!-- периоды вагона не пересекаются -->
    <changeSet id="02-location-indexes-ex_wagon_status_overlap" author="zhsr">
        <sql>alter table wagon_status add constraint ex_wagon_status_overlap exclude using gist (wagon with =, tstzrange(dbeg, dend) with &amp;&amp;)</sql>
    </changeSet>

    <!-- wagon_responsible -->

    <changeSet id="02-location-indexes-fk_wagon_responsible_wagon" author="zhsr">
        <addForeignKeyConstraint baseTableName="wagon_responsible" baseColumnNames="wagon" constraintName="fk_wagon_responsible_wagon"
                                 referencedTableName="wagon" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_wagon_responsible_created_by_usr" author="zhsr">
        <addForeignKeyConstraint baseTableName="wagon_responsible" baseColumnNames="created_by_usr" constraintName="fk_wagon_responsible_created_by_usr"
                                 referencedTableName="usr" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_wagon_responsible_trip" author="zhsr">
        <addForeignKeyConstraint baseTableName="wagon_responsible" baseColumnNames="trip" constraintName="fk_wagon_responsible_trip"
                                 referencedTableName="trip" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-ck_wagon_responsible_period" author="zhsr">
        <sql>alter table wagon_responsible add constraint ck_wagon_responsible_period check (dend is null or dend &gt; dbeg)</sql>
    </changeSet>

    <!-- слой: 1 - план, 2 - факт (WagonResponsibleKind); статус плана: 1 - ожидает, 2 - отработан, 3 - отменён
         (WagonResponsiblePlanStatus) - только у плана -->
    <changeSet id="02-location-indexes-ck_wagon_responsible_kind" author="zhsr">
        <sql>alter table wagon_responsible add constraint ck_wagon_responsible_kind check (kind in (1, 2) and (kind = 1) = (plan_status is not null) and (plan_status is null or plan_status in (1, 2, 3)))</sql>
    </changeSet>

    <!-- у вагона одна открытая запись факта -->
    <changeSet id="02-location-indexes-ux_wagon_responsible_current" author="zhsr">
        <sql>create unique index ux_wagon_responsible_current on wagon_responsible (wagon) where kind = 2 and dend is null</sql>
    </changeSet>

    <!-- периоды факта вагона не пересекаются -->
    <changeSet id="02-location-indexes-ex_wagon_responsible_fact_overlap" author="zhsr">
        <sql>alter table wagon_responsible add constraint ex_wagon_responsible_fact_overlap exclude using gist (wagon with =, tstzrange(dbeg, dend) with &amp;&amp;) where (kind = 2)</sql>
    </changeSet>

    <!-- рейс и стадия: 1 - отправление, 2 - прибытие (WagonResponsibleTripPoint); у плана - обязательны и бессрочны;
         стадия - только с рейсом -->
    <changeSet id="02-location-indexes-ck_wagon_responsible_trip" author="zhsr">
        <sql>alter table wagon_responsible add constraint ck_wagon_responsible_trip check ((trip_point is null or (trip is not null and trip_point in (1, 2))) and (kind = 2 or (trip_point is not null and dend is null)))</sql>
    </changeSet>

    <!-- у вагона один ожидающий план на стадию рейса: по нему отметка находит план -->
    <changeSet id="02-location-indexes-ux_wagon_responsible_plan_waiting" author="zhsr">
        <sql>create unique index ux_wagon_responsible_plan_waiting on wagon_responsible (wagon, trip, trip_point) where kind = 1 and plan_status = 1</sql>
    </changeSet>

    <!-- записи рейса: планы и факты отметок - для отмены и переноса -->
    <changeSet id="02-location-indexes-ix_wagon_responsible_trip" author="zhsr">
        <createIndex tableName="wagon_responsible" indexName="ix_wagon_responsible_trip">
            <column name="trip"/>
            <column name="trip_point"/>
        </createIndex>
    </changeSet>

    <!-- wagon_responsible_usr: состав удаляется вместе с записью журнала -->

    <changeSet id="02-location-indexes-fk_wagon_responsible_usr_wagon_responsible" author="zhsr">
        <addForeignKeyConstraint baseTableName="wagon_responsible_usr" baseColumnNames="wagon_responsible" constraintName="fk_wagon_responsible_usr_wagon_responsible"
                                 referencedTableName="wagon_responsible" referencedColumnNames="id" onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_wagon_responsible_usr_usr" author="zhsr">
        <addForeignKeyConstraint baseTableName="wagon_responsible_usr" baseColumnNames="usr" constraintName="fk_wagon_responsible_usr_usr"
                                 referencedTableName="usr" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-uq_wagon_responsible_usr_wagon_responsible_usr" author="zhsr">
        <addUniqueConstraint tableName="wagon_responsible_usr" columnNames="wagon_responsible, usr" constraintName="uq_wagon_responsible_usr_wagon_responsible_usr"/>
    </changeSet>

    <!-- вагоны, за которые отвечает сотрудник -->
    <changeSet id="02-location-indexes-ix_wagon_responsible_usr_usr" author="zhsr">
        <createIndex tableName="wagon_responsible_usr" indexName="ix_wagon_responsible_usr_usr">
            <column name="usr"/>
        </createIndex>
    </changeSet>

    <!-- wagon_edit -->

    <changeSet id="02-location-indexes-fk_wagon_edit_wagon" author="zhsr">
        <addForeignKeyConstraint baseTableName="wagon_edit" baseColumnNames="wagon" constraintName="fk_wagon_edit_wagon"
                                 referencedTableName="wagon" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_wagon_edit_created_by_usr" author="zhsr">
        <addForeignKeyConstraint baseTableName="wagon_edit" baseColumnNames="created_by_usr" constraintName="fk_wagon_edit_created_by_usr"
                                 referencedTableName="usr" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_wagon_edit_wagon_location" author="zhsr">
        <addForeignKeyConstraint baseTableName="wagon_edit" baseColumnNames="wagon_location" constraintName="fk_wagon_edit_wagon_location"
                                 referencedTableName="wagon_location" referencedColumnNames="id" onDelete="SET NULL"/>
    </changeSet>

    <changeSet id="02-location-indexes-uq_wagon_edit_wagon_location" author="zhsr">
        <addUniqueConstraint tableName="wagon_edit" columnNames="wagon_location" constraintName="uq_wagon_edit_wagon_location"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_wagon_edit_wagon_status" author="zhsr">
        <addForeignKeyConstraint baseTableName="wagon_edit" baseColumnNames="wagon_status" constraintName="fk_wagon_edit_wagon_status"
                                 referencedTableName="wagon_status" referencedColumnNames="id" onDelete="SET NULL"/>
    </changeSet>

    <changeSet id="02-location-indexes-uq_wagon_edit_wagon_status" author="zhsr">
        <addUniqueConstraint tableName="wagon_edit" columnNames="wagon_status" constraintName="uq_wagon_edit_wagon_status"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_wagon_edit_wagon_responsible" author="zhsr">
        <addForeignKeyConstraint baseTableName="wagon_edit" baseColumnNames="wagon_responsible" constraintName="fk_wagon_edit_wagon_responsible"
                                 referencedTableName="wagon_responsible" referencedColumnNames="id" onDelete="SET NULL"/>
    </changeSet>

    <changeSet id="02-location-indexes-uq_wagon_edit_wagon_responsible" author="zhsr">
        <addUniqueConstraint tableName="wagon_edit" columnNames="wagon_responsible" constraintName="uq_wagon_edit_wagon_responsible"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_wagon_edit_closed_wagon_responsible" author="zhsr">
        <addForeignKeyConstraint baseTableName="wagon_edit" baseColumnNames="closed_wagon_responsible" constraintName="fk_wagon_edit_closed_wagon_responsible"
                                 referencedTableName="wagon_responsible" referencedColumnNames="id" onDelete="SET NULL"/>
    </changeSet>

    <changeSet id="02-location-indexes-ix_wagon_edit_wagon" author="zhsr">
        <createIndex tableName="wagon_edit" indexName="ix_wagon_edit_wagon">
            <column name="wagon"/>
        </createIndex>
    </changeSet>

    <!-- wagon_info: кэш удаляется вместе с вагоном -->

    <changeSet id="02-location-indexes-fk_wagon_info_wagon" author="zhsr">
        <addForeignKeyConstraint baseTableName="wagon_info" baseColumnNames="wagon" constraintName="fk_wagon_info_wagon"
                                 referencedTableName="wagon" referencedColumnNames="id" onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_wagon_info_station" author="zhsr">
        <addForeignKeyConstraint baseTableName="wagon_info" baseColumnNames="station" constraintName="fk_wagon_info_station"
                                 referencedTableName="station" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_wagon_info_depot" author="zhsr">
        <addForeignKeyConstraint baseTableName="wagon_info" baseColumnNames="depot" constraintName="fk_wagon_info_depot"
                                 referencedTableName="depot" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_wagon_info_yard" author="zhsr">
        <addForeignKeyConstraint baseTableName="wagon_info" baseColumnNames="yard" constraintName="fk_wagon_info_yard"
                                 referencedTableName="yard" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_wagon_info_trip" author="zhsr">
        <addForeignKeyConstraint baseTableName="wagon_info" baseColumnNames="trip" constraintName="fk_wagon_info_trip"
                                 referencedTableName="trip" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_wagon_info_wagon_status_type" author="zhsr">
        <addForeignKeyConstraint baseTableName="wagon_info" baseColumnNames="wagon_status_type" constraintName="fk_wagon_info_wagon_status_type"
                                 referencedTableName="wagon_status_type" referencedColumnNames="id"/>
    </changeSet>

    <!-- у вагона одно расположение или расположение не задано -->
    <changeSet id="02-location-indexes-ck_wagon_info_location" author="zhsr">
        <sql>alter table wagon_info add constraint ck_wagon_info_location check (num_nonnulls(station, depot, yard, trip) = num_nonnulls(location_type) and num_nonnulls(dbeg_location) = num_nonnulls(location_type))</sql>
    </changeSet>

    <changeSet id="02-location-indexes-fk_wagon_info_location_type" author="zhsr">
        <addForeignKeyConstraint baseTableName="wagon_info" baseColumnNames="location_type" constraintName="fk_wagon_info_location_type"
                                 referencedTableName="location_type" referencedColumnNames="id"/>
    </changeSet>

    <!-- заполнена ссылка, заданная видом расположения; id из location_type.tsv: 1 - станция, 2 - депо, 3 - рейс, 4 - парк отстоя -->
    <changeSet id="02-location-indexes-ck_wagon_info_location_type" author="zhsr">
        <sql>alter table wagon_info add constraint ck_wagon_info_location_type check (location_type is null or (location_type = 1 and station is not null) or (location_type = 2 and depot is not null) or (location_type = 3 and trip is not null) or (location_type = 4 and yard is not null))</sql>
    </changeSet>

    <changeSet id="02-location-indexes-ix_wagon_info_station" author="zhsr">
        <createIndex tableName="wagon_info" indexName="ix_wagon_info_station">
            <column name="station"/>
        </createIndex>
    </changeSet>

    <changeSet id="02-location-indexes-ix_wagon_info_depot" author="zhsr">
        <createIndex tableName="wagon_info" indexName="ix_wagon_info_depot">
            <column name="depot"/>
        </createIndex>
    </changeSet>

    <changeSet id="02-location-indexes-ix_wagon_info_yard" author="zhsr">
        <createIndex tableName="wagon_info" indexName="ix_wagon_info_yard">
            <column name="yard"/>
        </createIndex>
    </changeSet>

    <changeSet id="02-location-indexes-ix_wagon_info_trip" author="zhsr">
        <createIndex tableName="wagon_info" indexName="ix_wagon_info_trip">
            <column name="trip"/>
        </createIndex>
    </changeSet>

    <changeSet id="02-location-indexes-ix_wagon_info_wagon_status_type" author="zhsr">
        <createIndex tableName="wagon_info" indexName="ix_wagon_info_wagon_status_type">
            <column name="wagon_status_type"/>
        </createIndex>
    </changeSet>

    <changeSet id="02-location-indexes-fk_wagon_info_wagon_responsible" author="zhsr">
        <addForeignKeyConstraint baseTableName="wagon_info" baseColumnNames="wagon_responsible" constraintName="fk_wagon_info_wagon_responsible"
                                 referencedTableName="wagon_responsible" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-uq_wagon_info_wagon_responsible" author="zhsr">
        <addUniqueConstraint tableName="wagon_info" columnNames="wagon_responsible" constraintName="uq_wagon_info_wagon_responsible"/>
    </changeSet>

    <!-- trip -->

    <changeSet id="02-location-indexes-fk_trip_route" author="zhsr">
        <addForeignKeyConstraint baseTableName="trip" baseColumnNames="route" constraintName="fk_trip_route"
                                 referencedTableName="route" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_trip_train" author="zhsr">
        <addForeignKeyConstraint baseTableName="trip" baseColumnNames="train" constraintName="fk_trip_train"
                                 referencedTableName="train" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-ix_trip_train" author="zhsr">
        <createIndex tableName="trip" indexName="ix_trip_train">
            <column name="train"/>
        </createIndex>
    </changeSet>

    <changeSet id="02-location-indexes-fk_trip_departed_by_usr" author="zhsr">
        <addForeignKeyConstraint baseTableName="trip" baseColumnNames="departed_by_usr" constraintName="fk_trip_departed_by_usr"
                                 referencedTableName="usr" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_trip_arrived_by_usr" author="zhsr">
        <addForeignKeyConstraint baseTableName="trip" baseColumnNames="arrived_by_usr" constraintName="fk_trip_arrived_by_usr"
                                 referencedTableName="usr" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-ix_trip_route_planned_dt" author="zhsr">
        <createIndex tableName="trip" indexName="ix_trip_route_planned_dt">
            <column name="route"/>
            <column name="planned_dt"/>
        </createIndex>
    </changeSet>

    <!-- рейсы в статусе «план» (1) и «выполняется» (2): второй проход списка вагонов - рейсы вагона -->
    <changeSet id="02-location-indexes-ix_trip_active" author="zhsr">
        <sql>create index ix_trip_active on trip (trip_status_type) where trip_status_type in (1, 2)</sql>
    </changeSet>

    <!-- train -->

    <!-- обозначение уникально среди действующих поездов -->
    <changeSet id="02-location-indexes-ux_train_name" author="zhsr">
        <sql>create unique index ux_train_name on train (name) where dend is null</sql>
    </changeSet>

    <changeSet id="02-location-indexes-ck_train_period" author="zhsr">
        <sql>alter table train add constraint ck_train_period check (dend is null or dend &gt;= dbeg)</sql>
    </changeSet>

    <!-- train_wagon: состояние участия вагонов в поезде, слои План и Факт (journal-state-plan-fact.md) -->

    <!-- поезд с вагонами (и бывшими) не удаляется: история составов вагонов не теряется -->
    <changeSet id="02-location-indexes-fk_train_wagon_train" author="zhsr">
        <addForeignKeyConstraint baseTableName="train_wagon" baseColumnNames="train" constraintName="fk_train_wagon_train"
                                 referencedTableName="train" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_train_wagon_wagon" author="zhsr">
        <addForeignKeyConstraint baseTableName="train_wagon" baseColumnNames="wagon" constraintName="fk_train_wagon_wagon"
                                 referencedTableName="wagon" referencedColumnNames="id"/>
    </changeSet>

    <!-- слой: 1 - план, 2 - факт (TrainWagonKind); позиция - с 1 -->
    <changeSet id="02-location-indexes-ck_train_wagon_kind" author="zhsr">
        <sql>alter table train_wagon add constraint ck_train_wagon_kind check (kind in (1, 2) and seq &gt; 0)</sql>
    </changeSet>

    <changeSet id="02-location-indexes-ck_train_wagon_period" author="zhsr">
        <sql>alter table train_wagon add constraint ck_train_wagon_period check (dend is null or dend &gt; dbeg)</sql>
    </changeSet>

    <!-- вагон в каждый момент - не больше чем в одном поезде по факту; в ожидаемом составе занятость вагона проверяет
         приложение при планировании: просроченный план сдвигается на время последнего факта поезда, и ожидаемые
         составы двух поездов могут на время пересечься -->
    <changeSet id="02-location-indexes-ex_train_wagon_overlap" author="zhsr">
        <sql>alter table train_wagon add constraint ex_train_wagon_overlap exclude using gist (wagon with =, tstzrange(dbeg, dend) with &amp;&amp;) where (kind = 2)</sql>
    </changeSet>

    <!-- позиция в поезде в каждый момент - у одного вагона; проверяется в конце транзакции: сдвиг позиций закрывает и
         создаёт записи нескольких вагонов -->
    <changeSet id="02-location-indexes-ex_train_wagon_seq" author="zhsr">
        <sql>alter table train_wagon add constraint ex_train_wagon_seq exclude using gist (train with =, kind with =, seq with =, tstzrange(dbeg, dend) with &amp;&amp;) deferrable initially deferred</sql>
    </changeSet>

    <!-- открытые записи поезда: текущий и ожидаемый состав -->
    <changeSet id="02-location-indexes-ix_train_wagon_train" author="zhsr">
        <sql>create index ix_train_wagon_train on train_wagon (train, kind, dbeg)</sql>
    </changeSet>

    <changeSet id="02-location-indexes-ix_train_wagon_wagon" author="zhsr">
        <sql>create index ix_train_wagon_wagon on train_wagon (wagon, kind, dbeg)</sql>
    </changeSet>

    <!-- train_wagon_change: журнал прицепок и отцепок, слои План и Факт -->

    <changeSet id="02-location-indexes-fk_train_wagon_change_train" author="zhsr">
        <addForeignKeyConstraint baseTableName="train_wagon_change" baseColumnNames="train" constraintName="fk_train_wagon_change_train"
                                 referencedTableName="train" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_train_wagon_change_wagon" author="zhsr">
        <addForeignKeyConstraint baseTableName="train_wagon_change" baseColumnNames="wagon" constraintName="fk_train_wagon_change_wagon"
                                 referencedTableName="wagon" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="02-location-indexes-fk_train_wagon_change_station" author="zhsr">
