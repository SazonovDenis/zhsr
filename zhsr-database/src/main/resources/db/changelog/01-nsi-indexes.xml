<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <!-- НСИ: уникальность кодов и номеров, внешние ключи -->

    <!-- для запрета пересечения периодов: usr_depot, usr_category, журналы -->
    <changeSet id="01-nsi-indexes-btree_gist" author="zhsr">
        <sql>create extension if not exists btree_gist</sql>
    </changeSet>

    <changeSet id="01-nsi-indexes-uq_usr_login" author="zhsr">
        <addUniqueConstraint tableName="usr" columnNames="login" constraintName="uq_usr_login"/>
    </changeSet>

    <!-- телефон в формате +7XXXXXXXXXX -->
    <changeSet id="01-nsi-indexes-ck_usr_phone" author="zhsr">
        <sql>alter table usr add constraint ck_usr_phone check (phone ~ '^\+7[0-9]{10}$')</sql>
    </changeSet>

    <changeSet id="01-nsi-indexes-uq_route_type_code" author="zhsr">
        <addUniqueConstraint tableName="route_type" columnNames="code" constraintName="uq_route_type_code"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-uq_transport_type_code" author="zhsr">
        <addUniqueConstraint tableName="transport_type" columnNames="code" constraintName="uq_transport_type_code"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-uq_location_type_code" author="zhsr">
        <addUniqueConstraint tableName="location_type" columnNames="code" constraintName="uq_location_type_code"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-uq_trip_status_type_code" author="zhsr">
        <addUniqueConstraint tableName="trip_status_type" columnNames="code" constraintName="uq_trip_status_type_code"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-uq_crew_duty_type_code" author="zhsr">
        <addUniqueConstraint tableName="crew_duty_type" columnNames="code" constraintName="uq_crew_duty_type_code"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-uq_coupling_type_code" author="zhsr">
        <addUniqueConstraint tableName="coupling_type" columnNames="code" constraintName="uq_coupling_type_code"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-uq_transfer_direction_type_code" author="zhsr">
        <addUniqueConstraint tableName="transfer_direction_type" columnNames="code" constraintName="uq_transfer_direction_type_code"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-uq_act_status_type_code" author="zhsr">
        <addUniqueConstraint tableName="act_status_type" columnNames="code" constraintName="uq_act_status_type_code"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-uq_work_type_code" author="zhsr">
        <addUniqueConstraint tableName="work_type" columnNames="code" constraintName="uq_work_type_code"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-uq_wagon_status_type_code" author="zhsr">
        <addUniqueConstraint tableName="wagon_status_type" columnNames="code" constraintName="uq_wagon_status_type_code"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-uq_station_code" author="zhsr">
        <addUniqueConstraint tableName="station" columnNames="code" constraintName="uq_station_code"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-uq_depot_code" author="zhsr">
        <addUniqueConstraint tableName="depot" columnNames="code" constraintName="uq_depot_code"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-fk_depot_station" author="zhsr">
        <addForeignKeyConstraint baseTableName="depot" baseColumnNames="station" constraintName="fk_depot_station"
                                 referencedTableName="station" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-uq_yard_code" author="zhsr">
        <addUniqueConstraint tableName="yard" columnNames="code" constraintName="uq_yard_code"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-fk_yard_station" author="zhsr">
        <addForeignKeyConstraint baseTableName="yard" baseColumnNames="station" constraintName="fk_yard_station"
                                 referencedTableName="station" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-uq_wagon_type_code" author="zhsr">
        <addUniqueConstraint tableName="wagon_type" columnNames="code" constraintName="uq_wagon_type_code"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-uq_model_type_code" author="zhsr">
        <addUniqueConstraint tableName="model_type" columnNames="code" constraintName="uq_model_type_code"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-uq_wagon_number" author="zhsr">
        <addUniqueConstraint tableName="wagon" columnNames="number" constraintName="uq_wagon_number"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-fk_wagon_depot" author="zhsr">
        <addForeignKeyConstraint baseTableName="wagon" baseColumnNames="depot" constraintName="fk_wagon_depot"
                                 referencedTableName="depot" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-fk_wagon_wagon_type" author="zhsr">
        <addForeignKeyConstraint baseTableName="wagon" baseColumnNames="wagon_type" constraintName="fk_wagon_wagon_type"
                                 referencedTableName="wagon_type" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-fk_wagon_model_type" author="zhsr">
        <addForeignKeyConstraint baseTableName="wagon" baseColumnNames="model_type" constraintName="fk_wagon_model_type"
                                 referencedTableName="model_type" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-uq_route_train_number" author="zhsr">
        <addUniqueConstraint tableName="route" columnNames="train_number" constraintName="uq_route_train_number"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-fk_route_route_type" author="zhsr">
        <addForeignKeyConstraint baseTableName="route" baseColumnNames="route_type" constraintName="fk_route_route_type"
                                 referencedTableName="route_type" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-fk_route_transport_type" author="zhsr">
        <addForeignKeyConstraint baseTableName="route" baseColumnNames="transport_type" constraintName="fk_route_transport_type"
                                 referencedTableName="transport_type" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-uq_route_station_route_seq" author="zhsr">
        <addUniqueConstraint tableName="route_station" columnNames="route, seq" constraintName="uq_route_station_route_seq"/>
    </changeSet>

    <!-- остановки маршрута удаляются вместе с маршрутом -->
    <changeSet id="01-nsi-indexes-fk_route_station_route" author="zhsr">
        <addForeignKeyConstraint baseTableName="route_station" baseColumnNames="route" constraintName="fk_route_station_route"
                                 referencedTableName="route" referencedColumnNames="id" onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-fk_route_station_station" author="zhsr">
        <addForeignKeyConstraint baseTableName="route_station" baseColumnNames="station" constraintName="fk_route_station_station"
                                 referencedTableName="station" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-uq_request_status_type_code" author="zhsr">
        <addUniqueConstraint tableName="request_status_type" columnNames="code" constraintName="uq_request_status_type_code"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-uq_severity_type_code" author="zhsr">
        <addUniqueConstraint tableName="severity_type" columnNames="code" constraintName="uq_severity_type_code"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-uq_service_code" author="zhsr">
        <addUniqueConstraint tableName="service" columnNames="code" constraintName="uq_service_code"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-uq_fault_category_type_code" author="zhsr">
        <addUniqueConstraint tableName="fault_category_type" columnNames="code" constraintName="uq_fault_category_type_code"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-fk_fault_category_type_service" author="zhsr">
        <addForeignKeyConstraint baseTableName="fault_category_type" baseColumnNames="service" constraintName="fk_fault_category_type_service"
                                 referencedTableName="service" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-uq_fault_group_type_code" author="zhsr">
        <addUniqueConstraint tableName="fault_group_type" columnNames="code" constraintName="uq_fault_group_type_code"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-uq_fault_type_code" author="zhsr">
        <addUniqueConstraint tableName="fault_type" columnNames="code" constraintName="uq_fault_type_code"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-fk_fault_type_fault_group_type" author="zhsr">
        <addForeignKeyConstraint baseTableName="fault_type" baseColumnNames="fault_group_type" constraintName="fk_fault_type_fault_group_type"
                                 referencedTableName="fault_group_type" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-fk_fault_type_fault_category_type" author="zhsr">
        <addForeignKeyConstraint baseTableName="fault_type" baseColumnNames="fault_category_type" constraintName="fk_fault_type_fault_category_type"
                                 referencedTableName="fault_category_type" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-fk_fault_type_severity_type" author="zhsr">
        <addForeignKeyConstraint baseTableName="fault_type" baseColumnNames="severity_type" constraintName="fk_fault_type_severity_type"
                                 referencedTableName="severity_type" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-fk_fault_type_service" author="zhsr">
        <addForeignKeyConstraint baseTableName="fault_type" baseColumnNames="service" constraintName="fk_fault_type_service"
                                 referencedTableName="service" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-uq_role_type_code" author="zhsr">
        <addUniqueConstraint tableName="role_type" columnNames="code" constraintName="uq_role_type_code"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-fk_role_type_service" author="zhsr">
        <addForeignKeyConstraint baseTableName="role_type" baseColumnNames="service" constraintName="fk_role_type_service"
                                 referencedTableName="service" referencedColumnNames="id"/>
    </changeSet>

    <!-- usr_role -->

    <changeSet id="01-nsi-indexes-uq_usr_role_usr_role_type" author="zhsr">
        <addUniqueConstraint tableName="usr_role" columnNames="usr, role_type" constraintName="uq_usr_role_usr_role_type"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-fk_usr_role_usr" author="zhsr">
        <addForeignKeyConstraint baseTableName="usr_role" baseColumnNames="usr" constraintName="fk_usr_role_usr"
                                 referencedTableName="usr" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-fk_usr_role_role_type" author="zhsr">
        <addForeignKeyConstraint baseTableName="usr_role" baseColumnNames="role_type" constraintName="fk_usr_role_role_type"
                                 referencedTableName="role_type" referencedColumnNames="id"/>
    </changeSet>

    <!-- usr_depot -->

    <changeSet id="01-nsi-indexes-fk_usr_depot_usr" author="zhsr">
        <addForeignKeyConstraint baseTableName="usr_depot" baseColumnNames="usr" constraintName="fk_usr_depot_usr"
                                 referencedTableName="usr" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-fk_usr_depot_depot" author="zhsr">
        <addForeignKeyConstraint baseTableName="usr_depot" baseColumnNames="depot" constraintName="fk_usr_depot_depot"
                                 referencedTableName="depot" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-ix_usr_depot_depot" author="zhsr">
        <createIndex tableName="usr_depot" indexName="ix_usr_depot_depot">
            <column name="depot"/>
        </createIndex>
    </changeSet>

    <changeSet id="01-nsi-indexes-ck_usr_depot_period" author="zhsr">
        <sql>alter table usr_depot add constraint ck_usr_depot_period check (dend is null or dend &gt; dbeg)</sql>
    </changeSet>

    <!-- сотрудник в каждый момент работает не больше чем в одном депо -->
    <changeSet id="01-nsi-indexes-ex_usr_depot_overlap" author="zhsr">
        <sql>alter table usr_depot add constraint ex_usr_depot_overlap exclude using gist (usr with =, tsrange(dbeg, dend) with &amp;&amp;)</sql>
    </changeSet>

    <!-- category_type -->

    <changeSet id="01-nsi-indexes-uq_category_type_code" author="zhsr">
        <addUniqueConstraint tableName="category_type" columnNames="code" constraintName="uq_category_type_code"/>
    </changeSet>

    <!-- usr_category -->

    <changeSet id="01-nsi-indexes-fk_usr_category_usr" author="zhsr">
        <addForeignKeyConstraint baseTableName="usr_category" baseColumnNames="usr" constraintName="fk_usr_category_usr"
                                 referencedTableName="usr" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-fk_usr_category_category_type" author="zhsr">
        <addForeignKeyConstraint baseTableName="usr_category" baseColumnNames="category_type" constraintName="fk_usr_category_category_type"
                                 referencedTableName="category_type" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="01-nsi-indexes-ck_usr_category_period" author="zhsr">
        <sql>alter table usr_category add constraint ck_usr_category_period check (dend is null or dend &gt; dbeg)</sql>
    </changeSet>

    <!-- у сотрудника в каждый момент не больше одной категории -->
    <changeSet id="01-nsi-indexes-ex_usr_category_overlap" author="zhsr">
        <sql>alter table usr_category add constraint ex_usr_category_overlap exclude using gist (usr with =, tsrange(dbeg, dend) with &amp;&amp;)</sql>
    </changeSet>

</databaseChangeLog>
