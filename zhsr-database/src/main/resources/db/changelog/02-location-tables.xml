<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <!-- Расположение вагонов: журналы, рейсы, поезд, акты -->

    <!-- Журналы: запись действует с dbeg по dend (не включая); dend пуст - текущая запись.
         Документы ссылаются на записи журналов, которые они открыли. -->

    <!-- журнал расположения: ровно одна из ссылок station, depot, yard, trip - та, что задана location_type -->
    <changeSet id="02-location-tables-wagon_location" author="zhsr">
        <createTable tableName="wagon_location">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="wagon" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="dbeg" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="dend" type="timestamptz"/>
            <column name="location_type" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="station" type="bigint"/>
            <column name="depot" type="bigint"/>
            <column name="yard" type="bigint"/>
            <column name="trip" type="bigint"/>
        </createTable>
    </changeSet>

    <!-- журнал состояния -->
    <changeSet id="02-location-tables-wagon_status" author="zhsr">
        <createTable tableName="wagon_status">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="wagon" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="dbeg" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="dend" type="timestamptz"/>
            <column name="wagon_status_type" type="bigint">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- журнал ответственных за вагон: два слоя в одной таблице - план и факт (kind: 1 - план, 2 - факт,
         WagonResponsibleKind). Запись - период с dbeg по dend (не включая); dend пуст - период открыт: у факта -
         текущие ответственные, у плана - держать ответственных, пока план не изменят. Состав ответственных периода -
         wagon_responsible_usr. Периоды факта вагона не пересекаются; слои между собой не сверяются. Отсутствие
         открытой записи факта - ответственных нет.
         plan_status - статус плана (1 - ожидает, 2 - отработан, 3 - отменён, WagonResponsiblePlanStatus): только у
         плана; отметка факта переводит план в "отработан", совпали даты или нет.
         trip, trip_point - рейс и его стадия (1 - отправление, 2 - прибытие, WagonResponsibleTripPoint). План есть
         только у рейса: план ответственных на рейс - стадия "отправление", после рейса - "прибытие"; план ищется по
         рейсу и стадии, его dbeg - справочно, время стадии по плану рейса, dend пуст. Факт: trip и trip_point - отметка
         рейса, которая его записала; только trip - смена ответственных в рейсе без отметки; пусто - не рейс.
         created_by_usr, created_dt - кто и когда внёс: запланировал или отметил факт; comment - основания,
         примечания -->
    <changeSet id="02-location-tables-wagon_responsible" author="zhsr">
        <createTable tableName="wagon_responsible">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="wagon" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="kind" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="plan_status" type="integer"/>
            <column name="trip" type="bigint"/>
            <column name="trip_point" type="integer"/>
            <column name="dbeg" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="dend" type="timestamptz"/>
            <column name="created_by_usr" type="bigint"/>
            <column name="created_dt" type="timestamptz"/>
            <column name="comment" type="text"/>
        </createTable>
    </changeSet>

    <!-- состав ответственных периода журнала wagon_responsible: строка - один ответственный; сотрудник в периоде
         один раз -->
    <changeSet id="02-location-tables-wagon_responsible_usr" author="zhsr">
        <createTable tableName="wagon_responsible_usr">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="wagon_responsible" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="usr" type="bigint">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- ручная правка вагона (Ф-ВАГ-02, Ф-ВАГ-03): смена состояния или расположения администратором с комментарием;
         wagon_location, wagon_status, wagon_responsible - записи журналов, открытые правкой (ровно одна из
         wagon_location и wagon_status; ответственные - вместе со сменой расположения);
         closed_wagon_responsible - запись факта ответственных, закрытая правкой: отмена правки открывает её снова,
         в том числе когда правка сняла всех ответственных и новой записи не открыла -->
    <changeSet id="02-location-tables-wagon_edit" author="zhsr">
        <createTable tableName="wagon_edit">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="wagon" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="created_by_usr" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="created_dt" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="comment" type="text"/>
            <column name="wagon_location" type="bigint"/>
            <column name="wagon_status" type="bigint"/>
            <column name="wagon_responsible" type="bigint"/>
            <column name="closed_wagon_responsible" type="bigint"/>
        </createTable>
    </changeSet>

    <!-- кэш текущего состояния вагона для быстрого доступа; поля вычисляемые - копия текущих записей
         wagon_location, wagon_status, ссылка на открытую запись факта wagon_responsible и общий пробег, обновляется в той же транзакции, что и
         журналы -->
    <changeSet id="02-location-tables-wagon_info" author="zhsr">
        <createTable tableName="wagon_info">
            <column name="wagon" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <!-- расположение; все поля пусты - расположение не задано -->
            <column name="dbeg_location" type="timestamptz"/>
            <column name="location_type" type="bigint"/>
            <column name="station" type="bigint"/>
            <column name="depot" type="bigint"/>
            <column name="yard" type="bigint"/>
            <column name="trip" type="bigint"/>
            <column name="dbeg_status" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="wagon_status_type" type="bigint">
                <constraints nullable="false"/>
            </column>
            <!-- открытая запись факта wagon_responsible: начало и состав текущих ответственных; пусто -
                 ответственных нет -->
            <column name="wagon_responsible" type="bigint"/>
            <!-- общий пробег, км: wagon.initial_run_km плюс сумма wagon_run.km -->
            <column name="run_km" type="integer">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- поезд: вагоны, которые ходят вместе из рейса в рейс; вагоны поезда - train_wagon;
         name - обозначение поезда; dbeg - когда сформирован; dend - когда расформирован, пусто - действует -->
    <changeSet id="02-location-tables-train" author="zhsr">
        <createTable tableName="train">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="dbeg" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="dend" type="timestamptz"/>
        </createTable>
    </changeSet>

    <!-- рейс: поездка поезда по маршруту; train - поезд рейса, пусто - поезд ещё не назначен;
         записи журналов вагонов поезда, открытые отметкой отправления (прибытия), - текущие записи с dbeg, равным
         departed_dt (arrived_dt); исправление и отмена отметки правят именно их -->
    <changeSet id="02-location-tables-trip" author="zhsr">
        <createTable tableName="trip">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="route" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="train" type="bigint"/>
            <column name="planned_dt" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="trip_status_type" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="departed_dt" type="timestamptz"/>
            <column name="departed_by_usr" type="bigint"/>
            <!-- когда отметку отправления внесли: от него считается срок исправления и отмены -->
            <column name="departure_marked_dt" type="timestamptz"/>
            <column name="arrived_dt" type="timestamptz"/>
            <column name="arrived_by_usr" type="bigint"/>
            <!-- когда отметку прибытия внесли: от него считается срок исправления и отмены -->
            <column name="arrival_marked_dt" type="timestamptz"/>
        </createTable>
    </changeSet>

    <!-- участие вагона в поезде - состояние (doc/db-doc/journal-state-plan-fact.md): поезд и позиция вагона с периодом
         действия; строится журналом прицепок и отцепок train_wagon_change, напрямую не правится.
         kind - слой, константы TrainWagonKind в коде (1 - план, 2 - факт): факт - история, план - ожидаемый состав:
         открытые записи факта на время последнего факта поезда и ожидающие планы журнала после него; слой план поезда
         перестраивается при каждом изменении журнала поезда.
         seq - позиция в поезде, с 1: прицепка на позицию сдвигает вагоны с неё на 1 назад, отцепка - вагоны за
         отцепленным на 1 вперёд; сдвиг закрывает запись вагона и создаёт новую.
         dbeg, dend - период: dend пуст - запись открыта -->
    <changeSet id="02-location-tables-train_wagon" author="zhsr">
        <createTable tableName="train_wagon">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="train" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="wagon" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="kind" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="seq" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="dbeg" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="dend" type="timestamptz"/>
        </createTable>
    </changeSet>

    <!-- прицепка и отцепка вагона - журнал (doc/db-doc/journal-state-plan-fact.md): событие поезда и вагона в момент
         времени; по нему строится участие вагона в поезде train_wagon.
         kind - слой, константы TrainWagonKind в коде (1 - план, 2 - факт); plan_status - только у плана, константы
         TrainWagonPlanStatus (1 - ожидает, 2 - отработан, 3 - отменён); plan - у факта: отработанный им план.
         change_type - константы TrainWagonChangeType (1 - прицепка, 2 - отцепка); dt - время: у плана плановое, у
         факта фактическое; seq - позиция, на которую прицепляют вагон, у отцепки пусто.
         station - станция; trip и route_station - рейс и остановка его маршрута, если прицепка или отцепка в рейсе;
         пусто - вне рейса. usr - кто внёс: запланировал или отметил факт; comment - основания, примечания: приказ,
         причина.
         wagon_location, wagon_status, wagon_responsible - записи журналов вагона, открытые фактом в пути рейса;
         closed_wagon_responsible - запись факта ответственных, закрытая им: удаление факта открывает её снова -->
    <changeSet id="02-location-tables-train_wagon_change" author="zhsr">
        <createTable tableName="train_wagon_change">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="train" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="wagon" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="kind" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="plan_status" type="integer"/>
            <column name="change_type" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="dt" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="seq" type="integer"/>
            <column name="station" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="trip" type="bigint"/>
            <column name="route_station" type="bigint"/>
            <column name="plan" type="bigint"/>
            <column name="usr" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="comment" type="text"/>
            <column name="wagon_location" type="bigint"/>
            <column name="wagon_status" type="bigint"/>
            <column name="wagon_responsible" type="bigint"/>
            <column name="closed_wagon_responsible" type="bigint"/>
        </createTable>
    </changeSet>

    <!-- пробег вагона за участок рейса: от отправления или прицепки до прибытия или отцепки; строку вносит прибытие рейса
         или отцепка в пути, отмена прибытия или отцепки удаляет её;
         train_wagon_change - факт прицепки, с которого началось участие вагона в поезде; km - по route_station.km от
         начальной станции маршрута или остановки прицепки до конечной станции или остановки отцепки; общий пробег
         (wagon_info.run_km) - wagon.initial_run_km плюс сумма km -->
    <changeSet id="02-location-tables-wagon_run" author="zhsr">
        <createTable tableName="wagon_run">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="wagon" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="trip" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="train_wagon_change" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="km" type="integer">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- бригада рейса: проводники, начальник поезда, поездной электромеханик; строка - дежурство сотрудника в рейсе
         с должностью: один сотрудник - одна строка; начальник поезда и ПЭМ - не больше одного на рейс; за какие вагоны
         отвечает сотрудник - журнал ответственных (wagon_responsible), не бригада;
         dbeg - заступление на дежурство (отправление рейса); dend - окончание (прибытие рейса); до отправления строки
         правятся и удаляются, с отправления - не удаляются -->
    <changeSet id="02-location-tables-trip_crew" author="zhsr">
        <createTable tableName="trip_crew">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="trip" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="usr" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="crew_duty_type" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="dbeg" type="timestamptz"/>
            <column name="dend" type="timestamptz"/>
        </createTable>
    </changeSet>

    <!-- Акты - таблицы бумажных документов с суффиксом _act -->

    <!-- акт отмены; на него ссылается отменённый акт -->
    <changeSet id="02-location-tables-act_cancellation" author="zhsr">
        <createTable tableName="act_cancellation">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="created_by_usr" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="created_dt" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="text">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- акт приёма-передачи вагонов между станцией, её депо и парками отстоя: откуда - ровно одна из ссылок
         from_station, from_depot, from_yard, куда - ровно одна из to_station, to_depot, to_yard; откуда и куда -
         разные расположения одной станции, со станции на станцию не передаётся;
         transferred_by_usr, transferred_dt - кто и когда сдал; received_by_usr, received_dt - кто и когда принял или отказал;
         act_status_type: ожидает приёма - приём не отмечен, расположение не меняется; проведён - принят, вагоны
         переходят в расположение "куда"; отказ - reject_reason, расположение не меняется; отменён - со ссылкой
         act_cancellation, весь акт целиком; акт можно оформить сразу принятым -->
    <changeSet id="02-location-tables-transfer_act" author="zhsr">
        <createTable tableName="transfer_act">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="number" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="from_station" type="bigint"/>
            <column name="from_depot" type="bigint"/>
            <column name="from_yard" type="bigint"/>
            <column name="to_station" type="bigint"/>
            <column name="to_depot" type="bigint"/>
            <column name="to_yard" type="bigint"/>
            <column name="work_type" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="act_status_type" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="transferred_by_usr" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="transferred_dt" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="received_by_usr" type="bigint"/>
            <column name="received_dt" type="timestamptz"/>
            <column name="reject_reason" type="text"/>
            <column name="act_cancellation" type="bigint"/>
        </createTable>
    </changeSet>

    <!-- вагоны акта приёма-передачи; wagon_location - запись журнала расположения, открытая приёмом: расположение
         "куда"; пуста, пока акт не принят; wagon_responsible - запись факта ответственных, открытая актом при
         передаче (при приёме состав ответственных можно сменить в той же записи); closed_wagon_responsible - запись
         факта ответственных, закрытая актом; все три пусты у отменённого акта и при отказе: отмена и отказ удаляют
         открытые записи и снова открывают закрытую -->
    <changeSet id="02-location-tables-transfer_act_wagon" author="zhsr">
        <createTable tableName="transfer_act_wagon">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="transfer_act" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="wagon" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="seq" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="with_property" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="note" type="text"/>
            <column name="wagon_location" type="bigint"/>
            <column name="wagon_responsible" type="bigint"/>
            <column name="closed_wagon_responsible" type="bigint"/>
        </createTable>
    </changeSet>

    <!-- положение сотрудника на местности по времени, очищенные данные;
         x - долгота, y - широта (WGS 84); dt - момент, в который вычислено положение -->
    <changeSet id="02-location-tables-usr_geo_location" author="zhsr">
        <createTable tableName="usr_geo_location">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="usr" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="dt" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="x" type="numeric(9,6)">
                <constraints nullable="false"/>
            </column>
            <column name="y" type="numeric(9,6)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- положение вагона на местности по времени, очищенные данные: вычисляется по положению ответственных за вагон, а у
         вагона без ответственных - по составу поезда; у вагона вне рейса новых строк нет - он стоит там, где последняя;
         x - долгота, y - широта (WGS 84); dt - момент, в который вычислено положение -->
    <changeSet id="02-location-tables-wagon_geo_location" author="zhsr">
        <createTable tableName="wagon_geo_location">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="wagon" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="dt" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="x" type="numeric(9,6)">
                <constraints nullable="false"/>
            </column>
            <column name="y" type="numeric(9,6)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
