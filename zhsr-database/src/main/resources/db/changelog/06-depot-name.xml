<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <!-- название депо - одно, вместо названий на трёх языках: прежнее название на русском -->
    <changeSet id="06-depot-name-depot-name" author="zhsr">
        <addColumn tableName="depot">
            <column name="name" type="varchar(255)"/>
        </addColumn>
        <sql>update depot set name = name_ru</sql>
        <addNotNullConstraint tableName="depot" columnName="name" columnDataType="varchar(255)"/>
        <dropColumn tableName="depot" columnName="name_ru"/>
        <dropColumn tableName="depot" columnName="name_kk"/>
        <dropColumn tableName="depot" columnName="name_en"/>
    </changeSet>

    <!-- справочник депо изменился: фронт загрузит его заново -->
    <changeSet id="06-depot-name-dict_version" author="zhsr">
        <sql>update dict_version set version = version + 1 where name = 'Depot'</sql>
    </changeSet>

</databaseChangeLog>
