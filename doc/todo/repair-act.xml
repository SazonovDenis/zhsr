<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <!-- Ремонт вагона: акты ВУ-23 и ВУ-36. Не входит в db.changelog-master.xml, подключается отдельно
         после 02-location-*: ссылается на wagon, wagon_status, wagon_location, work_type -->

    <!-- таблицы -->

    <!-- ремонт вагона, ВУ-23: открывает ремонт; created_* - кто и когда оформил;
         wagon_status - запись журнала состояния, открытая ВУ-23: в ремонте; пуста у отменённого акта -->
    <changeSet id="repair-act-repair_act" author="zhsr">
        <createTable tableName="repair_act">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="number" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="wagon" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="work_type" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="defect" type="varchar(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="created_dt" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="wagon_status" type="bigint"/>
            <column name="cancelled_by" type="varchar(100)"/>
            <column name="cancelled_dt" type="timestamp"/>
            <column name="cancel_reason" type="varchar(1000)"/>
        </createTable>
    </changeSet>

    <!-- закрытие ремонта, ВУ-36: по акту ремонта; created_* - кто и когда оформил;
         wagon_status - запись журнала состояния, открытая ВУ-36: в простое;
         wagon_location - запись журнала расположения, если ВУ-36 вывел вагон из депо на станцию;
         записи пусты у отменённого акта: отмена удаляет записи -->
    <changeSet id="repair-act-repair_close_act" author="zhsr">
        <createTable tableName="repair_close_act">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="number" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="repair_act" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="created_dt" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="wagon_status" type="bigint"/>
            <column name="wagon_location" type="bigint"/>
            <column name="next_repair_date" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="cancelled_by" type="varchar(100)"/>
            <column name="cancelled_dt" type="timestamp"/>
            <column name="cancel_reason" type="varchar(1000)"/>
        </createTable>
    </changeSet>

    <!-- уникальность, внешние ключи, проверки, индексы -->

    <!-- repair_act; "у вагона не больше одного открытого ремонта" проверяет приложение:
         открытость зависит от repair_close_act, частичным индексом не выражается -->

    <changeSet id="repair-act-uq_repair_act_number" author="zhsr">
        <addUniqueConstraint tableName="repair_act" columnNames="number" constraintName="uq_repair_act_number"/>
    </changeSet>

    <changeSet id="repair-act-fk_repair_act_work_type" author="zhsr">
        <addForeignKeyConstraint baseTableName="repair_act" baseColumnNames="work_type" constraintName="fk_repair_act_work_type"
                                 referencedTableName="work_type" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="repair-act-fk_repair_act_wagon" author="zhsr">
        <addForeignKeyConstraint baseTableName="repair_act" baseColumnNames="wagon" constraintName="fk_repair_act_wagon"
                                 referencedTableName="wagon" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="repair-act-ix_repair_act_wagon" author="zhsr">
        <createIndex tableName="repair_act" indexName="ix_repair_act_wagon">
            <column name="wagon"/>
        </createIndex>
    </changeSet>

    <changeSet id="repair-act-fk_repair_act_wagon_status" author="zhsr">
        <addForeignKeyConstraint baseTableName="repair_act" baseColumnNames="wagon_status" constraintName="fk_repair_act_wagon_status"
                                 referencedTableName="wagon_status" referencedColumnNames="id" onDelete="SET NULL"/>
    </changeSet>

    <changeSet id="repair-act-uq_repair_act_wagon_status" author="zhsr">
        <addUniqueConstraint tableName="repair_act" columnNames="wagon_status" constraintName="uq_repair_act_wagon_status"/>
    </changeSet>

    <!-- отмена заполняется целиком или не заполняется -->
    <changeSet id="repair-act-ck_repair_act_cancel" author="zhsr">
        <sql>alter table repair_act add constraint ck_repair_act_cancel check (num_nulls(cancelled_by, cancelled_dt, cancel_reason) in (0, 3))</sql>
    </changeSet>

    <!-- запись состояния пуста только у отменённого акта -->
    <changeSet id="repair-act-ck_repair_act_wagon_status" author="zhsr">
        <sql>alter table repair_act add constraint ck_repair_act_wagon_status check (wagon_status is not null or cancelled_dt is not null)</sql>
    </changeSet>

    <!-- repair_close_act -->

    <changeSet id="repair-act-uq_repair_close_act_number" author="zhsr">
        <addUniqueConstraint tableName="repair_close_act" columnNames="number" constraintName="uq_repair_close_act_number"/>
    </changeSet>

    <changeSet id="repair-act-fk_repair_close_act_repair_act" author="zhsr">
        <addForeignKeyConstraint baseTableName="repair_close_act" baseColumnNames="repair_act" constraintName="fk_repair_close_act_repair_act"
                                 referencedTableName="repair_act" referencedColumnNames="id"/>
    </changeSet>

    <!-- у акта ремонта не больше одного неотменённого ВУ-36 -->
    <changeSet id="repair-act-ux_repair_close_act_repair_act" author="zhsr">
        <sql>create unique index ux_repair_close_act_repair_act on repair_close_act (repair_act) where cancelled_dt is null</sql>
    </changeSet>

    <changeSet id="repair-act-fk_repair_close_act_wagon_status" author="zhsr">
        <addForeignKeyConstraint baseTableName="repair_close_act" baseColumnNames="wagon_status" constraintName="fk_repair_close_act_wagon_status"
                                 referencedTableName="wagon_status" referencedColumnNames="id" onDelete="SET NULL"/>
    </changeSet>

    <changeSet id="repair-act-uq_repair_close_act_wagon_status" author="zhsr">
        <addUniqueConstraint tableName="repair_close_act" columnNames="wagon_status" constraintName="uq_repair_close_act_wagon_status"/>
    </changeSet>

    <changeSet id="repair-act-fk_repair_close_act_wagon_location" author="zhsr">
        <addForeignKeyConstraint baseTableName="repair_close_act" baseColumnNames="wagon_location" constraintName="fk_repair_close_act_wagon_location"
                                 referencedTableName="wagon_location" referencedColumnNames="id" onDelete="SET NULL"/>
    </changeSet>

    <changeSet id="repair-act-uq_repair_close_act_wagon_location" author="zhsr">
        <addUniqueConstraint tableName="repair_close_act" columnNames="wagon_location" constraintName="uq_repair_close_act_wagon_location"/>
    </changeSet>

    <!-- отмена заполняется целиком или не заполняется -->
    <changeSet id="repair-act-ck_repair_close_act_cancel" author="zhsr">
        <sql>alter table repair_close_act add constraint ck_repair_close_act_cancel check (num_nulls(cancelled_by, cancelled_dt, cancel_reason) in (0, 3))</sql>
    </changeSet>

    <!-- запись состояния пуста только у отменённого акта -->
    <changeSet id="repair-act-ck_repair_close_act_wagon_status" author="zhsr">
        <sql>alter table repair_close_act add constraint ck_repair_close_act_wagon_status check (wagon_status is not null or cancelled_dt is not null)</sql>
    </changeSet>

</databaseChangeLog>
