#!/bin/bash
# Положить файлы демо-данных в хранилище файлов (S3, контейнер zhsr-s3): фото демо-заявок, чек-листов и описей
# db-data/demo/img - с ключом demo/img/<файл>, на них ссылаются db-data/demo/22-repair_request_photo.tsv,
# 34-check_list_value_photo.tsv и 37-equip_list_value_photo.tsv. Файлы копируются в контейнер и кладутся
# клиентом mc из образа хранилища (внутри контейнера адрес хранилища - localhost:9000); тип файла mc берёт по
# расширению. Бакет S3_BUCKET должен уже быть (prepare/storage-reset).
# Параметры - в .env; нет .env - копируется из .env.sample.
#
#   prepare/files-demo
# Обычно вызывается из env-reset --demo.
set -euo pipefail
# пути данных и .env - от корня проекта
cd "$(dirname "$0")/.."

[ -f .env ] || { cp .env.sample .env; echo '.env создан из .env.sample'; }
set -a; . ./.env; set +a

echo "--- хранилище файлов: фото демо-заявок -> $S3_BUCKET/demo/img"
docker exec zhsr-s3 rm -rf /tmp/demo-img
docker cp db-data/demo/img zhsr-s3:/tmp/demo-img
# вывод mc (таблица объёма и скорости) не нужен: ошибки mc идут в stderr
docker exec -e "MC_HOST_zhsr=http://$S3_ACCESS_KEY:$S3_SECRET_KEY@localhost:9000" zhsr-s3 \
  sh -c "mc cp --quiet /tmp/demo-img/*.jpg zhsr/$S3_BUCKET/demo/img/ >/dev/null && rm -rf /tmp/demo-img"

echo "--- готово: файлов в хранилище: $(ls db-data/demo/img/*.jpg | wc -l)"
