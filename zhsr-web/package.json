{
  "name": "zhsr-web",
  "version": "0.0.1",
  "description": "ZHSR — веб-клиент",
  "productName": "Жолсерік",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "quasar dev -m pwa",
    "build": "quasar build -m pwa",
    "typecheck": "vue-tsc --noEmit",
    "lint": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore && eslint --fix -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "lint:check": "prettier --check \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore && eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "i18n:check": "node scripts/i18n-check.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --pass-with-no-tests",
    "postinstall": "quasar prepare --silent && npm install --prefix src-pwa"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "@stomp/stompjs": "^7.5.0",
    "axios": "^1.21.0",
    "dexie": "^4.4.7",
    "leaflet": "^1.9.4",
    "mitt": "^3.0.1",
    "pinia": "^4.1.0",
    "quasar": "^2.35.2",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@playwright/test": "^1.64.1",
    "@quasar/app-vite": "^3.10.3",
    "@quasar/vite-plugin": "^2.0.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.19.11",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.8",
    "prettier": "^3.9.10",
    "typescript": "^6.0.0",
    "vite-plugin-checker": "^0.14.5",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">= 26 || ^24 || ^22.22"
  }
}
