# Образец .env: app-start, env-build, env-start, env-reset и скрипты prepare/*-reset копируют его в .env, если .env нет. В git - только образец, .env - в .gitinore.
# .env читают zhsr-app и zhsr-database (Spring: spring.config.import) и скрипты env-build, env-start, env-stop, env-reset, prepare/db-reset, prepare/storage-reset.

# Имя tenant: часть идентификатора БД zhsr-<TENANT_NAME>-<случайное число>, его пишет prepare/db-reset
TENANT_NAME=dev

# Подключение приложения к БД
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zhsr
DB_USER=zhsr
DB_PASSWORD=zhsr
DB_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}

# Суперпользователь PostgreSQL: под ним prepare/db-reset удаляет и создаёт БД и пользователя DB_USER;
# env-start заводит его в контейнере БД
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=postgres

# S3-хранилище файлов (фото заявок): env-start поднимает его в контейнере zhsr-s3 с этими ключами;
# prepare/storage-reset очищает хранилище и создаёт бакет S3_BUCKET
S3_PORT=9010
S3_CONSOLE_PORT=9011
S3_ENDPOINT=http://localhost:${S3_PORT}
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=zhsr

# Демо-сервер (скрипты install/remote-*)
# DEPLOY_HOST - пользователь@Public IPv4 DNS instance; пользователь зависит от AMI: ubuntu (Ubuntu), ec2-user (Amazon Linux).
DEPLOY_HOST=ubuntu@ec2-0-0-0-0.eu-north-1.compute.amazonaws.com
# DEPLOY_SSH_KEY - private key: путь от корня проекта или абсолютный
DEPLOY_SSH_KEY=aws/apache.pem
# DEPLOY_DIR - каталог приложения на сервере (не путать с каталогом документации PUBLISH_DIR)
DEPLOY_DIR=/opt/zhsr

# Публикация документации (publish-doc): пользователь@сервер, каталог на сервере, ssh-ключ
PUBLISH_HOST=ec2-user@ec2-13-61-33-23.eu-north-1.compute.amazonaws.com
PUBLISH_KEY=aws/apache.pem
PUBLISH_DIR=/var/www/html/zhsr/
