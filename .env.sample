# Образец .env: app-start, env-start, env-reset и скрипты install/*-reset копируют его в .env, если .env нет. В git -
# только этот образец, .env - локальный.
# .env читают zhsr-app и zhsr-database (Spring: spring.config.import) и скрипты env-start, env-stop, env-reset,
# install/db-reset, install/storage-reset.
# Формат - строки ИМЯ=значение без пробелов и кавычек: файл одновременно свойства Spring и скрипт shell.

# Подключение приложения к БД
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zhsr
DB_USER=zhsr
DB_PASSWORD=zhsr
DB_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}

# Суперпользователь PostgreSQL: под ним install/db-reset удаляет и создаёт БД и пользователя DB_USER;
# env-start заводит его в контейнере БД
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=postgres

# S3-хранилище файлов (фото заявок): env-start поднимает его в контейнере zhsr-s3 с этими ключами;
# install/storage-reset очищает хранилище и создаёт бакет S3_BUCKET
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:${S3_PORT}
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=zhsr

