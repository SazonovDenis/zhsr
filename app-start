#!/bin/bash
# Запустить сервер zhsr-app (http://localhost:8080).
# Веб-клиент запускается отдельно: app-start-web.
set -euo pipefail
cd "$(dirname "$0")"

[ -f .env ] || { cp .env.sample .env; echo '.env создан из .env.sample'; }

xterm -hold -geometry 300x50+0+0 -title "zhsr-app" -e "./gradlew :zhsr-app:bootRun" &
echo $! > .zhsr-app.pid
