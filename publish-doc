#!/bin/sh
# Публикация _site на сервер документации утилитой build-doc (каталог - в BUILD_DOC, по умолчанию ../../build-doc от
# корня проекта). Сервер, каталог на нём и ключ - PUBLISH_HOST, PUBLISH_DIR, PUBLISH_KEY в .env; ключа нет - из
# zholserik.
set -e

ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

[ -f .env ] || { echo "Нет .env (образец - .env.sample)" >&2; exit 1; }
set -a; . ./.env; set +a

: "${PUBLISH_HOST:?в .env задайте PUBLISH_HOST: пользователь@адрес сервера документации}"
: "${PUBLISH_DIR:?в .env задайте PUBLISH_DIR: каталог документации на сервере}"

BUILD_DOC="${BUILD_DOC:-$ROOT/../../build-doc}"
# ~ в пути из .env оболочка не раскрывает
KEY=$(eval echo "${PUBLISH_KEY:-$ROOT/aws/apache.pem}")
[ -f "$KEY" ] || KEY="$ROOT/../zholserik/aws/apache.pem"

"$BUILD_DOC/publish-doc" -i "$KEY" "$PUBLISH_HOST:$PUBLISH_DIR"
